<script>
(function(){
  /* ===== imagens ausentes viram placeholder visível ===== */
  function phFor(t){
    var d = document.createElement('div');
    d.className = 'ph ph-sm';
    d.textContent = 'IMAGEM AUSENTE: ' + (t.getAttribute('src')||'');
    t.replaceWith(d);
  }
  document.addEventListener('error', function(e){
    var t = e.target;
    if(t && t.tagName === 'IMG') phFor(t);
  }, true);
  /* varre as que já falharam antes do listener */
  document.querySelectorAll('img').forEach(function(i){
    if(i.complete && i.naturalWidth === 0) phFor(i);
  });

  /* ===== reveal on scroll ===== */
  try{
    if(!('IntersectionObserver' in window)) throw 0;
    /* threshold 0 + rootMargin: dispara assim que o elemento encosta na viewport.
       Com threshold .15 um flick-scroll rapido no telemovel podia saltar o callback
       e a seccao ficava presa em opacity:0 para sempre. */
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('on'); io.unobserve(e.target); } });
    },{threshold:0, rootMargin:'0px 0px -8% 0px'});
    document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });
    /* rede de seguranca: qualquer .rv que ja passou pela viewport aparece,
       mesmo que o observer tenha perdido o callback */
    var sweeping = false;
    function sweep(){
      sweeping = false;
      var vh = window.innerHeight;
      document.querySelectorAll('.rv:not(.on)').forEach(function(el){
        if(el.getBoundingClientRect().top < vh) el.classList.add('on');
      });
    }
    function queueSweep(){ if(!sweeping){ sweeping = true; requestAnimationFrame(sweep); } }
    window.addEventListener('scroll', queueSweep, {passive:true});
    window.addEventListener('resize', queueSweep);
    window.addEventListener('load', queueSweep);
    setTimeout(sweep, 1200);
  }catch(e){ document.querySelectorAll('.rv').forEach(function(el){ el.classList.add('on'); }); }

  /* ===== marquee UGC: lazy não dispara com transform, então força o load ao chegar perto ===== */
  (function(){
    var mq = document.querySelector('.sp-mq');
    if(!mq) return;
    function loadAll(){
      mq.querySelectorAll('img[loading="lazy"]').forEach(function(im){ im.loading = 'eager'; });
    }
    if(!('IntersectionObserver' in window)){ loadAll(); return; }
    var io2 = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ loadAll(); io2.disconnect(); } });
    },{rootMargin:'400px 0px'});
    io2.observe(mq);
  })();

  /* ===== timeline de resultados: trilho colore conforme a rolagem ===== */
  (function(){
    var tl = document.querySelector('.expect .tl');
    if(!tl) return;
    var items = [].slice.call(tl.querySelectorAll('.tl-item'));
    var ticking = false;
    function paint(){
      ticking = false;
      var r = tl.getBoundingClientRect();
      var full = Math.max(0, r.height - 20);       /* trilho vai de top:10 a bottom:10 */
      tl.style.setProperty('--tlh', full + 'px');
      /* linha de leitura: 58% da altura da janela */
      var anchor = window.innerHeight * 0.58;
      var p = Math.max(0, Math.min(full, anchor - (r.top + 10)));
      tl.style.setProperty('--tlp', p + 'px');
      items.forEach(function(it){
        var h = it.querySelector('.tl-head').getBoundingClientRect();
        it.classList.toggle('lit', (h.top + h.height/2) <= anchor);
      });
    }
    function onScroll(){
      if(ticking) return;
      ticking = true;
      window.requestAnimationFrame(paint);
    }
    window.addEventListener('scroll', onScroll, {passive:true});
    window.addEventListener('resize', onScroll);
    window.addEventListener('load', paint);
    paint();
  })();

  /* ===== carrossel de reviews: dots + navegação ===== */
  var rvCar = document.getElementById('rvCar'), rvDots = document.getElementById('rvDots');
  if(rvCar && rvDots){
    var cards = rvCar.querySelectorAll('.rvcard');
    function perView(){
      if(!cards.length) return 1;
      var cw = cards[0].getBoundingClientRect().width + 20;
      return Math.max(1, Math.round(rvCar.clientWidth / cw));
    }
    function pages(){ return Math.max(1, Math.ceil(cards.length / perView())); }
    function cur(){
      var max = rvCar.scrollWidth - rvCar.clientWidth;
      if(max <= 0) return 0;
      return Math.round(rvCar.scrollLeft / max * (pages() - 1));
    }
    function build(){
      var n = pages(), c = cur(), h = '';
      for(var i = 0; i < n; i++) h += '<button type="button" class="rvc-dot' + (i===c?' on':'') + '" aria-label="Slide ' + (i+1) + '"></button>';
      rvDots.innerHTML = h;
      rvDots.querySelectorAll('.rvc-dot').forEach(function(d, i){
        d.addEventListener('click', function(){
          var max = rvCar.scrollWidth - rvCar.clientWidth;
          rvCar.scrollTo({left: max * (i / Math.max(1, pages()-1)), behavior:'smooth'});
        });
      });
    }
    /* setas prev/next (desktop) */
    var rvPrev = document.getElementById('rvPrev'), rvNext = document.getElementById('rvNext');
    /* mira no card de destino em vez de scrollBy: com scroll-snap mandatory o scrollBy
       desloca e o snap devolve para onde estava. O offsetLeft do card É um ponto de snap. */
    function stepTo(dir){
      var list = [].slice.call(cards);
      if(!list.length) return;
      var i = 0, best = Infinity;
      for(var k = 0; k < list.length; k++){
        var d = Math.abs((list[k].offsetLeft - rvCar.offsetLeft) - rvCar.scrollLeft);
        if(d < best){ best = d; i = k; }
      }
      var t = Math.max(0, Math.min(list.length - 1, i + dir * perView()));
      rvCar.scrollTo({left: list[t].offsetLeft - rvCar.offsetLeft, behavior:'smooth'});
    }
    /* alinha as setas ao centro da FOTO do card (o wrap inclui o corpo do card e os dots) */
    function placeNav(){
      if(!rvPrev || !rvNext) return;
      var ph = rvCar.querySelector('.rvcard-ph');
      if(!ph) return;
      var b = ph.getBoundingClientRect(), w = rvCar.parentElement.getBoundingClientRect();
      var top = (b.top - w.top) + b.height / 2;
      rvPrev.style.top = rvNext.style.top = top + 'px';
    }
    function navState(){
      if(!rvPrev || !rvNext) return;
      var max = rvCar.scrollWidth - rvCar.clientWidth;
      rvPrev.disabled = rvCar.scrollLeft <= 2;
      rvNext.disabled = rvCar.scrollLeft >= max - 2;
    }
    if(rvPrev && rvNext){
      rvPrev.addEventListener('click', function(){ stepTo(-1); });
      rvNext.addEventListener('click', function(){ stepTo(1); });
    }
    function sync(){
      var c = cur();
      rvDots.querySelectorAll('.rvc-dot').forEach(function(d,i){ d.classList.toggle('on', i===c); });
      navState();
    }
    rvCar.addEventListener('scroll', sync, {passive:true});
    window.addEventListener('resize', function(){ build(); navState(); placeNav(); });
    window.addEventListener('load', placeNav);
    build();
    navState();
    placeNav();
  }

  /* ===== oferta: galeria + contador de compras ===== */
  var galMain=document.getElementById('galMain');
  document.querySelectorAll('.gal-thumbs button').forEach(function(b){
    b.addEventListener('click',function(){
      galMain.src=b.getAttribute('data-src');
      document.querySelectorAll('.gal-thumbs button').forEach(function(o){o.classList.remove('on');});
      b.classList.add('on');
    });
  });
  var bc=document.getElementById('buyCount'), bcv=527;
  function bump(){ bcv+=1; if(bc) bc.textContent=bcv.toLocaleString('en-US'); }
  (function tick(){ var d=18000+Math.floor((bcv%7)*2000); setTimeout(function(){ bump(); tick(); }, d); })();


  /* ===== FAQ: fecha os outros ao abrir ===== */
  document.querySelectorAll('details.qa').forEach(function(d){
    d.addEventListener('toggle', function(){
      if(d.open){ document.querySelectorAll('details.qa[open]').forEach(function(o){ if(o!==d) o.open=false; }); }
    });
  });
})();
</script>
</body>
</html>