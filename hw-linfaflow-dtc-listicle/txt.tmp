<style>
.results{background:#fff;border-top:1px solid #e4efe6;border-bottom:1px solid #e4efe6;padding:44px 0 40px}
.rv-head{text-align:center;margin:0 0 6px;font-family:'DM Serif Display',Georgia,serif;font-weight:400;font-size:clamp(28px,3.4vw,42px);line-height:1.1;color:var(--navy)}
.rv-head span{display:block;color:var(--red)}
.rv-sub{text-align:center;font-size:clamp(15px,1.5vw,18px);color:var(--navy-2);margin:0 0 26px}
.rvc-wrap{position:relative;max-width:1240px;margin:0 auto;padding:0 18px}
.rvc{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding:4px 2px}
.rvc::-webkit-scrollbar{display:none}
.rvcard{flex:0 0 calc((100% - 40px)/3);min-width:0;scroll-snap-align:center;background:#fff;border:1px solid #dfeee3;border-radius:14px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 2px 10px rgba(18,60,42,.07)}
.rvcard-ph{position:relative;line-height:0;background:#eef5f0}
.rvcard-ph img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}
.rv-tag{position:absolute;bottom:10px;font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:11px;letter-spacing:.6px;text-transform:uppercase;color:#fff;padding:5px 11px;border-radius:5px;line-height:1.1}
.rv-tag.before{left:10px;background:rgba(18,60,42,.88)}
.rv-tag.after{right:10px;background:#1FA45C}
.rvcard-bd{padding:16px 18px 18px;display:flex;flex-direction:column;flex:1}
.rv-res{font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:17px;color:var(--navy);line-height:1.25;margin:0 0 6px}
.rv-stars{color:#F5A623;letter-spacing:2px;font-size:14px;margin-bottom:9px}
.rv-quote{font-size:14.5px;color:#41564a;line-height:1.55;margin:0 0 14px}
.rv-meta{margin-top:auto;display:flex;align-items:center;flex-wrap:wrap;gap:9px;font-size:13.5px}
.rv-nm{font-weight:800;color:var(--ink)}
img.rv-vb{width:19px;height:19px;max-width:none;object-fit:contain;flex:0 0 auto;display:inline-block;vertical-align:-4px}
/* setas do carrossel — só desktop. Ficam no .rvc-wrap (o .rvc tem overflow e as levaria junto).
   O -30px no top compensa a altura do bloco de dots, que também está dentro do wrap. */
.rvc-nav{position:absolute;top:calc(50% - 30px);transform:translateY(-50%);z-index:3;width:44px;height:44px;padding:0;border-radius:50%;border:1px solid #dfeee3;background:#fff;box-shadow:0 3px 12px rgba(18,60,42,.16);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:transform .12s ease,box-shadow .2s,opacity .2s}
.rvc-nav:hover{transform:translateY(-50%) scale(1.08);box-shadow:0 5px 16px rgba(18,60,42,.22)}
.rvc-nav svg{width:19px;height:19px;fill:none;stroke:var(--navy);stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
.rvc-nav.prev{left:-8px}
.rvc-nav.next{right:-8px}
.rvc-nav[disabled]{opacity:.3;pointer-events:none}
@media(max-width:680px){.rvc-nav{display:none}}
.rvc-dots{display:flex;justify-content:center;gap:8px;margin-top:20px}
.rvc-dot{width:8px;height:8px;border-radius:50%;background:#cfe3d4;border:none;padding:0;cursor:pointer;transition:background .2s,transform .2s}
.rvc-dot.on{background:var(--red);transform:scale(1.25)}
.rv-stock{display:flex;align-items:center;justify-content:center;gap:8px;margin:24px 0 12px;font-size:13.5px;font-weight:700;color:var(--navy-2)}
.rv-stock .dot{width:8px;height:8px;border-radius:50%;background:#1FA45C;flex:0 0 auto}
.rv-cta{display:block;width:100%;max-width:520px;margin:0 auto;box-sizing:border-box;background:linear-gradient(180deg,#2FCB63 0%,#12A84A 100%);color:#fff;text-decoration:none;text-align:center;font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:clamp(17px,2vw,23px);padding:18px 24px;border-radius:999px;box-shadow:0 8px 20px rgba(0,173,33,.32);transition:transform .12s ease,filter .2s}
.rv-cta:hover{transform:translateY(-2px);filter:brightness(1.06)}
.rv-cta .arr{display:inline-flex;align-items:center;justify-content:center;width:27px;height:27px;border-radius:50%;background:rgba(255,255,255,.26);margin-left:.5em;font-size:17px;line-height:1;vertical-align:middle}
.rv-guar{display:flex;align-items:center;justify-content:center;gap:7px;margin:12px 0 0;font-size:13.5px;font-weight:700;color:var(--navy-2)}
.rw-disc{text-align:center;font-style:italic;color:#8a998e;font-size:13px;margin-top:18px}
@media(max-width:1000px){.rvcard{flex:0 0 calc((100% - 20px)/2)}}
@media(max-width:680px){
  .rvcard{flex:0 0 86%}
  .rvc{gap:14px}
  .rvc-wrap{padding:0 14px}
  .rv-res{font-size:15.5px}
  .rv-quote{font-size:14px}
  .rv-cta{font-size:17px;padding:16px 18px}
}
</style>
