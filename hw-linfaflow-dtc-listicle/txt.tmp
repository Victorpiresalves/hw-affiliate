<!DOCTYPE html>
<!-- V3-LINFAFLOW-LISTICLE — diagramação copiada do modelo Resilia.
     Fotos = placeholders. Copy nova = Lorem ipsum (class="lorem"). -->
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>document.documentElement.className+=" js";</script>
<title>5 Reasons — Linfaflow®</title>
<meta name="description" content="Discover how women are finally waking up with a face they recognize, losing the sock marks at their ankles, and getting through the afternoon without heavy legs — without water pills, salt-free food, or $180 massage appointments.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,600;0,700;0,800;1,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#123C2A;      /* verde-floresta profundo (títulos, fundos escuros) */
  --navy-2:#5C7C69;    /* sálvia média (texto secundário) */
  --cream:#F1FAF3;     /* verde clarissimo (fundos de seção) */
  --cream-2:#FFFFFF;   /* fundo da página — luz branca */
  --orange:#C4922F;    /* dourado do selo de garantia */
  --lime:#87E64B;      /* verde-limão dos botões de CTA */
  --orange-2:#E4C36E;  /* dourado claro */
  --red:#1FA45C;       /* verde-marca vibrante (acentos) */
  --red-2:#178048;     /* verde-marca escuro */
  --hl:#D9F7E2;        /* marca-texto */
  --green:#1FA45C;     /* checks */
  --ink:#20302A;
  --ph-bg:#E6EEE6;
  --ph-line:#A9C0AC;
  --maxw:720px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;text-size-adjust:100%}
html,body{overflow-x:hidden;max-width:100%;background:var(--cream-2)}
h1,h2,h3,h4,.hl-h3,.maya-title,.display{overflow-wrap:break-word}
body{font-family:'Inter',Arial,sans-serif;color:var(--ink);background:var(--cream-2);font-size:19px;line-height:1.55;-webkit-font-smoothing:antialiased}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 18px}
.display{font-family:'DM Serif Display','Inter',Georgia,serif;font-weight:400;letter-spacing:0;line-height:1.14;text-transform:none}
h1.display{font-size:clamp(32px,6vw,50px)}
h2.display{font-size:clamp(26px,4.6vw,38px)}
.accent{color:var(--red)}
.accent-o{color:var(--orange-2)}
section{padding:44px 0}
p{margin:0 0 18px}
em{font-style:italic}
strong{font-weight:800}

/* ===== top bar / header ===== */
.topbar{background:var(--navy);color:#fff;text-align:center;padding:8px 12px;font-size:14px;font-weight:600;letter-spacing:.3px}
.topbar b{color:var(--orange-2)}
header.site{background:var(--cream);border-bottom:1px solid #d9e4d8;padding:14px 0;position:relative;z-index:5}
.logo{font-family:'Inter',Arial,sans-serif;font-size:34px;letter-spacing:2px;color:var(--navy);text-align:center;line-height:1}
.logo span{color:var(--orange)}
.stars{color:#F5A623;font-size:18px;letter-spacing:2px}

/* ===== placeholders ===== */
.ph{background:repeating-linear-gradient(45deg,var(--ph-bg),var(--ph-bg) 14px,#eef3ea 14px,#eef3ea 28px);border:2px dashed var(--ph-line);border-radius:12px;display:flex;align-items:center;justify-content:center;text-align:center;color:#6d7d6f;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:1px;padding:10px}
.ph-sm{min-height:110px}.ph-md{min-height:220px}.ph-lg{min-height:330px}

/* ===== buttons / cta ===== */
.btn{display:block;width:100%;max-width:560px;margin:0 auto;background:linear-gradient(180deg,#2FCB63 0%,#12A84A 100%);color:#fff;text-decoration:none;text-align:center;font-weight:800;font-size:22px;padding:20px 26px;border-radius:999px;box-shadow:0 6px 16px rgba(35,95,59,.4);transition:transform .12s ease}
.btn:hover{transform:translateY(-2px)}
.btn .arr{display:inline-block;margin-left:8px;transition:transform .15s}
.btn:hover .arr{transform:translateX(5px)}
.btn-orange{background:linear-gradient(180deg,#9BF25C 0%,#63D62F 100%);color:var(--navy);box-shadow:0 6px 16px rgba(135,230,75,.42)}
.under-btn{display:flex;gap:8px;align-items:flex-start;justify-content:center;margin-top:14px;font-size:15.5px;font-weight:700;color:var(--navy)}
.under-btn .shield{flex:0 0 auto}
img.shield{width:17px;height:17px;max-width:none;object-fit:contain;flex:0 0 auto;display:inline-block;vertical-align:-3px}
img.us-flag{width:19px;height:19px;max-width:none;object-fit:contain;flex:0 0 auto;display:inline-block;vertical-align:-4px}

/* ===== section headers ===== */
.sec-head{text-align:center;color:var(--navy);margin-bottom:10px}
.sec-sub{text-align:center;font-size:20px;color:var(--navy-2);max-width:620px;margin:0 auto 30px}
/* subtítulos: Inter Regular */
.sec-sub,.hl-sub,.hl-eyebrow,.born .sub{font-family:'Inter',Arial,sans-serif;font-weight:400}
.sec-sub strong,.hl-sub strong,.born .sub strong{font-weight:600}

/* ===== proof / results (diagramação ref. SkinnyFit GLP-1) ===== */
.results{background:#fff;border-top:1px solid #d9e4d8;border-bottom:1px solid #d9e4d8}
.results .wrap-wide{max-width:1200px;margin:0 auto;padding:0 18px}
.rw-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:8px 0 4px}
.rw-card{background:#fff;border:1px solid #e0e9dd;border-radius:12px;box-shadow:0 2px 6px rgba(30,61,43,.10);display:flex;flex-direction:column;overflow:hidden}
.rw-photo{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:2px;height:240px;background:#eef3ea;overflow:hidden}
.rw-img{grid-column:1/-1;width:100%;height:100%;object-fit:cover;display:block}
.rw-photo .ph{border-radius:0;border:none;min-height:0;height:100%;grid-column:1/-1}
.rw-badge{position:absolute;bottom:12px;padding:6px 11px;border-radius:12px;color:#fff;line-height:1.15;text-align:left;box-shadow:0 2px 8px rgba(0,0,0,.25)}
.rw-badge small{display:block;font-size:9px;letter-spacing:1.8px;font-weight:800;text-transform:uppercase;opacity:.85}
.rw-badge b{font-size:14.5px;font-weight:800}
.rw-badge.before{left:12px;background:var(--navy)}
.rw-badge.after{right:12px;background:var(--red)}
.rw-body{padding:18px 16px 14px;text-align:center;display:flex;flex-direction:column;flex:1}
.rw-stars{color:#F5A623;letter-spacing:3px;font-size:15px}
.rw-quote{font-size:15px;color:var(--navy-2);text-align:left;margin:10px 0 14px;line-height:1.5}
.rw-meta{display:flex;justify-content:space-between;align-items:center;gap:8px;border-top:1px solid #eaf1e8;padding-top:11px;margin-top:auto}
.rw-name{font-weight:800;font-size:14.5px;color:var(--ink)}
.rw-verified{color:var(--green);font-weight:800;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;white-space:nowrap}
.rw-verified:before{content:"✓ ";font-weight:900}
.rw-disc{text-align:center;font-style:italic;color:#7a8577;font-size:13.5px;margin-top:20px}
@media(max-width:900px){.rw-grid{grid-template-columns:1fr;gap:18px;max-width:420px;margin:0 auto}}
@media(min-width:601px) and (max-width:900px){.rw-grid{grid-template-columns:repeat(2,1fr);max-width:760px;gap:20px}}
@media(max-width:640px){.rw-grid{gap:14px;max-width:320px}.rw-photo{height:210px}.rw-disc{margin-top:12px;font-size:12.5px}}

/* ===== story ===== */
.story{background:var(--cream-2)}
.kicker{display:block;text-align:center;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;color:var(--red);font-size:14px;margin-bottom:12px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:center;margin:26px 0}
@media(max-width:640px){.split{grid-template-columns:1fr}}
.split>div{min-width:0}
.arrlist li,.dotlist li{list-style:none;display:flex;gap:12px;align-items:flex-start;padding:10px 0;font-size:18.5px}
/* bullets em card (ref. SlimSoda: card branco + borda de acento) */
.xlist{display:flex;flex-direction:column;gap:13px;margin:24px 0}
.xlist li{list-style:none;display:flex;gap:11px;align-items:center;background:#D9F2E3;border:none;border-radius:10px;padding:14px 16px;font-size:16.5px;font-weight:600;color:var(--ink);line-height:1.45}
.xlist .x{flex:0 0 auto;width:34px;height:34px;max-width:none;object-fit:contain;display:inline-block;padding:6px;background:#fff;border-radius:50%;box-shadow:0 1px 3px rgba(18,60,42,.12)}
/* lista longa de sintomas: 2 colunas + fecho em destaque (quebra a repetição) */
.xlist.xgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:stretch}
.xlist.xgrid li{align-items:center}
/* alterna preenchido / contorno para dar ritmo na leitura */
.xlist.xgrid li:nth-child(even){background:#fff;border:1.5px solid #BFE8CF}
.xlist.xgrid li:nth-child(even) .x{background:#EAF7EF}
.xlist.xgrid li:last-child{grid-column:1 / -1;background:var(--navy);border:none;color:#fff;font-weight:700;justify-content:center;text-align:center;font-size:17.5px}
.xlist.xgrid li:last-child .x{background:#fff}
@media(max-width:700px){.xlist.xgrid{grid-template-columns:1fr}.xlist.xgrid li:last-child{font-size:15.5px;text-align:left;justify-content:flex-start}}
.dotlist .d{color:var(--red);flex:0 0 auto;font-size:22px;line-height:1.2}
.hl-h3{font-family:'DM Serif Display',Georgia,serif;font-weight:400;font-size:clamp(30px,5vw,40px);line-height:1.14;color:var(--navy);margin:34px 0 16px}
.marker{background:linear-gradient(0deg,var(--hl) 0%,var(--hl) 100%);box-decoration-break:clone;-webkit-box-decoration-break:clone;padding:2px 6px}
.quotebig{font-size:21px;font-weight:800;font-style:italic;color:var(--navy);border-left:5px solid var(--orange);padding:6px 0 6px 18px;margin:22px 0}
/* destaque em bloco: faixa colorida + citação (ref. SlimSoda) */
.qbox{margin:26px 0;border:1px solid #BFE8CF;border-radius:4px;overflow:hidden}
.qbox-h{background:#D9F2E3;color:var(--navy);font-weight:800;font-size:17.5px;line-height:1.35;padding:13px 18px;text-align:center}
.qbox-q{background:#fff;margin:0;padding:15px 18px;font-style:italic;font-size:17.5px;line-height:1.45;color:var(--ink);text-align:center}
/* bloco de destaque com borda verde à esquerda (nota de layout do doc) */
.greenbox{background:#fff;border:1px solid #e0e9dd;border-left:6px solid var(--red);border-radius:12px;padding:20px 22px;margin:24px 0;font-size:18.5px}
.greenbox p{margin:0 0 12px}
.greenbox p:last-child{margin:0}
/* destaques em pílula preenchida (ref. SlimSoda) */
.forces{display:grid;gap:12px;margin:24px 0}
.force{background:#D9F2E3;border:none;border-radius:10px;padding:15px 17px;font-size:16.5px;line-height:1.5;color:var(--ink);display:flex;gap:12px;align-items:flex-start}
.fc-ic{flex:0 0 auto;width:30px;height:30px;max-width:none;object-fit:contain;margin-top:1px}
.force strong{color:var(--navy)}
.interstitial{text-align:center;font-size:clamp(24px,4vw,32px);font-weight:800;color:var(--navy);margin:36px 0 22px}
.real{width:100%;display:block;border-radius:12px;object-fit:cover}
.story-img{width:100%;border-radius:12px;border:1px solid #e0e9dd}
.story-img-flow{margin:22px 0}
@media(min-width:641px){.bullets-split{align-items:center}.bullets-split .xlist{margin:0}.bullets-split .xlist li{font-size:19px}}

/* ===== Nora intro (estilo PQ7): foto esquerda + texto direita ===== */
.maya-hero{display:grid;grid-template-columns:280px minmax(0,1fr);gap:28px;align-items:center;margin:6px 0 10px}
.maya-photo{position:relative;line-height:0;width:280px;aspect-ratio:1/1;overflow:hidden;border-radius:12px}
.maya-photo .ph{width:100%;height:100%;border-radius:12px;line-height:1.4}
.maya-cap{position:absolute;left:14px;bottom:14px;background:#fff;border:2px solid var(--navy);color:var(--navy);font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:19px;letter-spacing:.5px;padding:6px 14px;box-shadow:4px 4px 0 rgba(30,61,43,.9)}
.story-float{float:right;width:44%;max-width:310px;margin:4px 0 14px 24px;border-radius:12px;display:block;shape-outside:margin-box}
.story .xlist,.story .greenbox,.story .hl-h3,.story .interstitial{clear:both}
@media(max-width:640px){.story-float{float:none;width:100%;max-width:420px;margin:16px auto 18px}}
.maya-txt .maya-title{font-size:clamp(28px,4vw,42px);line-height:1.05;margin:0 0 16px}
.maya-txt p{margin:0 0 14px}
@media(max-width:640px){
  .maya-hero{grid-template-columns:1fr;gap:16px}
  .maya-photo{max-width:420px;margin:0 auto;width:100%}
  .maya-cap{font-size:19px;left:10px;bottom:10px}
  .maya-txt .maya-title{font-size:clamp(28px,8vw,40px)}
}
.maya-title{font-family:'DM Serif Display',Georgia,serif;font-weight:400;line-height:1.06;text-transform:none;color:var(--navy);margin:0 0 18px;letter-spacing:0}
.maya-title span{color:var(--red)}

/* ===== born cta ===== */
.born{background:var(--navy);color:#fff;padding:54px 0}
.born h2{color:#fff;text-align:center}
.born .sub{color:#dfe9e0;text-align:center;font-size:20px;max-width:600px;margin:10px auto 30px}
.born-grid.one{display:block;max-width:520px;margin:0 auto 28px}
.born-grid>*{min-width:0}
.born-img{width:100%;height:auto;border-radius:12px;object-fit:contain}
@media(min-width:768px){
  .born{padding:44px 0}
  .born .wrap.born-cols{max-width:1040px;display:grid;grid-template-columns:1.05fr 1fr;grid-template-areas:"h img" "sub img" "btn img" "ub img";column-gap:44px;align-items:center;align-content:center}
  .born .wrap.born-cols>h2{grid-area:h;text-align:left}
  .born .wrap.born-cols>.sub{grid-area:sub;text-align:left;margin:14px 0 0;max-width:none}
  .born .wrap.born-cols>.born-grid.one{grid-area:img;max-width:420px;margin:0 auto;align-self:center}
  .born .wrap.born-cols>.btn{grid-area:btn;font-size:19px;padding:16px 20px;max-width:420px;margin:26px 0 0}
  .born .wrap.born-cols>.under-btn{grid-area:ub;justify-content:flex-start;margin-top:14px}
}

/* ===== ingredientes em linha (estilo PQ7) ===== */
.ing{background:#fff;border-top:1px solid #d9e4d8;border-bottom:1px solid #d9e4d8}
.wrap-wide-ing{max-width:1744px;margin:0 auto;padding:0 18px}
.ing-cols{display:grid;grid-template-columns:minmax(0,890fr) minmax(0,1180fr);gap:clamp(18px,2.7vw,59px);align-items:stretch;margin-top:26px}
.ing-vis{min-width:0;display:flex;align-items:center;justify-content:center;background:#E9FDF3;border-radius:10px;overflow:hidden}
.ing-vis img{width:100%;height:auto;display:block}
.ing-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;align-items:stretch;margin-top:0}
@media(max-width:1000px){
  .ing-cols{grid-template-columns:1fr;gap:18px}
  .ing-vis{max-width:760px;margin:0 auto;background:none}
}
@media(max-width:640px){.ing-grid{grid-template-columns:1fr}}
.ing-grid>div{min-width:0}
.ing-card{background:var(--cream-2);padding:0;border:1.5px solid var(--navy);border-radius:10px;overflow:visible;display:flex;flex-direction:column}
.ing-head{background:var(--navy);color:#fff;border-radius:10px 3px 0 0;padding:11px 62px 10px 13px;position:relative;min-height:53px}
.ing-head .nm{display:block;font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:19px;letter-spacing:.4px;line-height:1;color:#fff}
.ing-head .role{display:block;color:var(--orange-2);font-weight:700;font-size:9.2px;letter-spacing:1px;text-transform:uppercase;margin-top:4px}
.ing-png{position:absolute;top:-18px;right:6px;width:67px;height:67px;object-fit:contain;filter:drop-shadow(0 3px 6px rgba(0,0,0,.28))}
.ing-bd{padding:13px 13px 11px;display:flex;flex-direction:column;flex:1}
.ing-desc{font-size:13.5px;font-weight:600;margin-bottom:8px}
.ing-bd ul{margin:0 0 11px}
.ing-bd li{list-style:none;display:flex;gap:7px;padding:5.5px 0;font-size:12.5px;border-bottom:1px solid #e7efe5}
.ing-bd li:last-child{border-bottom:none}
.ing-bd li .b{color:var(--orange);flex:0 0 auto;font-weight:900}
.ing-foot{background:var(--hl);border-radius:10px;padding:8px 10px;text-align:center;margin-top:auto}
.ing-foot .r{display:block;font-weight:800;font-size:11px;color:var(--navy)}
.ing-foot .ar{display:block;color:var(--red);font-weight:900;line-height:1.1;font-size:13px}
.ing-foot .t{display:block;font-size:11px;font-weight:700;color:var(--navy)}
/* header compacto só nesta seção, para caber em uma tela */
#science{padding:26px 0}
#science .kicker{font-size:12px;letter-spacing:2px;margin-bottom:8px}
#science .sec-head{font-size:clamp(26px,2.3vw,34px);margin-bottom:7px}
#science .sec-sub{font-size:16px;max-width:520px;margin:0 auto 4px}
.sec-img{width:100%;max-width:760px;margin:22px auto 0;display:block;border-radius:12px}

/* ===== 4 step ===== */
/* 4-step reset — lista vertical com conector pontilhado (ref. SlimSoda) */
.steps{background:var(--cream)}
.steps-hero{max-width:300px;margin:14px auto 4px}
.steps-hero img{width:100%;height:auto;display:block}
.steps-list{max-width:620px;margin:20px auto 0}
.stp{position:relative;display:grid;grid-template-columns:52px minmax(0,1fr);gap:16px;padding-bottom:26px}
.stp:last-child{padding-bottom:0}
/* conector: começa embaixo do círculo e morre no círculo seguinte */
.stp:not(:last-child):before{content:"";position:absolute;left:25px;top:54px;bottom:0;width:0;border-left:3px dotted #9FD9B6}
.stp-ic{position:relative;z-index:1;width:52px;height:52px;border-radius:50%;background:linear-gradient(180deg,#2FCB63,#12A84A);display:flex;align-items:center;justify-content:center;box-shadow:0 3px 10px rgba(18,168,74,.28)}
.stp-ic svg{width:26px;height:26px;stroke:#fff;fill:none;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round}
.stp-bd{min-width:0}
.stp-hd{display:flex;align-items:center;flex-wrap:wrap;gap:10px;min-height:52px;margin-bottom:4px}
.stp-nm{font-family:'DM Serif Display',Georgia,serif;font-weight:400;font-size:26px;line-height:1.1;color:var(--navy)}
.stp-tag{display:inline-flex;align-items:center;font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:12.5px;letter-spacing:.7px;text-transform:uppercase;line-height:1;color:#12A84A;background:#EAF8F0;border:1.5px solid #BFE3CD;border-radius:999px;padding:6px 12px}
.stp p{margin:0;font-size:16.5px;line-height:1.5;color:var(--ink)}
.steps .close{font-size:20px;font-weight:800;text-align:center;color:var(--navy);max-width:600px;margin:28px auto 0}

/* ===== day (timeline vertical, ref. PQ7 / prnt.sc GLiHy4GrJ1gw) ===== */
.day{background:var(--cream)}
.day-wide{max-width:1220px;margin:0 auto;padding:0 24px}
.tl2{position:relative;max-width:900px;margin:30px auto 0}
.tl2:before{content:"";position:absolute;left:50%;top:6px;bottom:6px;width:3px;background:var(--red);opacity:.3;transform:translateX(-50%)}
.tl2-row{position:relative;display:grid;grid-template-columns:1fr 52px 1fr;align-items:start;margin-bottom:30px}
.tl2-row:last-child{margin-bottom:0}
.tl2-node{grid-column:2;justify-self:center;margin-top:8px;width:40px;height:40px;border-radius:50%;background:var(--red);display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 6px var(--cream);z-index:2}
.tl2-node svg{width:18px;height:18px;stroke:#fff;stroke-width:3;fill:none}
.tl2-label{display:flex;align-items:center;gap:10px;padding-top:8px}
.tl2-label:first-child{grid-column:1;justify-content:flex-end;text-align:right}
.tl2-label:last-child{grid-column:3;justify-content:flex-start;text-align:left}
.tl2-ic{width:28px;height:28px;flex:0 0 auto}
.tl2-ic svg{width:100%;height:100%;stroke:var(--navy);fill:none;stroke-width:2}
.tl2-lname{font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:22px;color:var(--navy)}
.tl2-box{position:relative;background:#fff;border:1.5px solid var(--navy);border-radius:12px;padding:14px 18px}
.tl2-box:first-child{grid-column:1;margin-right:16px}
.tl2-box:last-child{grid-column:3;margin-left:16px}
.tl2-box:first-child:before{content:"";position:absolute;top:16px;right:-9px;border-width:8px 0 8px 9px;border-style:solid;border-color:transparent transparent transparent var(--navy)}
.tl2-box:first-child:after{content:"";position:absolute;top:18px;right:-6.5px;border-width:6px 0 6px 7px;border-style:solid;border-color:transparent transparent transparent #fff}
.tl2-box:last-child:before{content:"";position:absolute;top:16px;left:-9px;border-width:8px 9px 8px 0;border-style:solid;border-color:transparent var(--navy) transparent transparent}
.tl2-box:last-child:after{content:"";position:absolute;top:18px;left:-6.5px;border-width:6px 7px 6px 0;border-style:solid;border-color:transparent #fff transparent transparent}
.tl2-box ul{margin:0}
.tl2-box li{list-style:none;display:flex;gap:8px;font-weight:700;font-size:14.5px;line-height:1.42;color:var(--ink);padding:3px 0}
.tl2-box li .tb{color:var(--red);font-weight:900;flex:0 0 auto}
@media(max-width:760px){
  .tl2:before{left:19px}
  .tl2-row{grid-template-columns:38px 1fr;column-gap:12px;margin-bottom:26px}
  .tl2-node{grid-column:1;grid-row:1 / 3;align-self:start;justify-self:start;margin-top:2px;width:34px;height:34px}
  .tl2-node svg{width:16px;height:16px}
  .tl2-label,.tl2-label:first-child,.tl2-label:last-child{grid-column:2;grid-row:1;justify-content:flex-start;text-align:left;padding-top:2px}
  .tl2-box,.tl2-box:first-child,.tl2-box:last-child{grid-column:2;grid-row:2;margin:10px 0 0}
  .tl2-box:before,.tl2-box:after,.tl2-box:first-child:before,.tl2-box:first-child:after,.tl2-box:last-child:before,.tl2-box:last-child:after{display:none}
  .tl2-lname{font-size:19px}
  .tl2-box li{font-size:14px}
}
.noline{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:10px 56px;max-width:1160px;margin:40px auto 10px}
.nox{position:relative;display:inline-flex;align-items:center;justify-content:center;padding:26px 10px}
.nox-t{position:relative;z-index:2;font-weight:800;font-size:clamp(24px,3.4vw,34px);color:var(--navy);white-space:nowrap}
.nox-x{position:absolute;z-index:1;top:50%;left:50%;transform:translate(-50%,-50%);width:88px;height:89px;max-width:none;flex:0 0 auto;object-fit:contain;pointer-events:none}
@media(max-width:640px){.noline{gap:14px 0;flex-direction:column;margin:30px auto 6px}.nox{padding:24px 10px}.nox-t{font-size:24px;white-space:normal;text-align:center}.nox-x{width:78px;height:79px}}

/* ===== urgency (hd2) ===== */
.urgency{background:var(--cream-2);padding:40px 0}
.hd2{display:grid;grid-template-columns:1fr 1fr;border-radius:12px;overflow:hidden;box-shadow:0 4px 14px rgba(30,61,43,.18)}
.hd2>div{min-width:0}
.hd2-img{line-height:0;overflow:hidden;height:100%}
.hd2-img img{width:100%;height:100%;object-fit:cover;display:block}
.hd2-img .ph{height:100%;min-height:240px;border-radius:0;border:none}
.hd2-panel{background:var(--navy);color:#fff;display:flex;flex-direction:column;justify-content:center;padding:22px 24px}
.hd2-head{font-family:'Inter',Arial,sans-serif;font-weight:600;font-size:clamp(20px,2.05vw,27px);line-height:1.22;letter-spacing:.2px;margin:0 0 18px}
.hd2-btn{display:block;align-self:stretch;text-align:center;background:linear-gradient(180deg,#9BF25C 0%,#63D62F 100%);color:var(--navy);text-decoration:none;font-family:'Inter',Arial,sans-serif;font-weight:800;text-transform:uppercase;letter-spacing:.2px;font-size:clamp(14px,1.45vw,18px);padding:13px 8px;border-radius:999px;box-shadow:0 6px 14px rgba(135,230,75,.4);transition:filter .2s}
.hd2-btn:hover{filter:brightness(1.07)}
.hd2-rea{display:flex;align-items:center;gap:7px;margin-top:12px;color:#dfe9e0;font-weight:600;font-size:12px}
@media(max-width:600px){.hd2{grid-template-columns:1fr}.hd2-panel{padding:20px 18px 22px}.hd2-head{font-size:clamp(16px,4.6vw,18px);line-height:1.2}.hd2-btn{font-size:16.5px;padding:13px 6px;white-space:normal}}

/* ===== who — colunas com ícones (estilo PQ7) ===== */
.whosec{padding:44px 0}
.who-wide{max-width:1180px;margin:0 auto;padding:0 24px}
.whoq{text-align:center}
.whoq-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:34px}
.whoq-grid>div{min-width:0}
.whoq-grid.n2{grid-template-columns:repeat(2,1fr);max-width:760px;margin:34px auto 0}
@media(min-width:1000px){.whoq-grid.n4{grid-template-columns:repeat(4,1fr)}}
@media(max-width:999px) and (min-width:761px){.whoq-grid.n4{grid-template-columns:repeat(2,1fr)}}
/* mobile: 2 colunas lado a lado (ref. SlimSoda), não empilhado */
@media(max-width:760px){.whoq-grid.n4,.whoq-grid,.whoq-grid.n2{grid-template-columns:repeat(2,1fr);gap:14px 8px;max-width:560px;margin-left:auto;margin-right:auto}}
.whoq-col{padding:8px 30px;position:relative;text-align:center}
.whoq-col+.whoq-col:before{content:"";position:absolute;left:0;top:20px;bottom:20px;width:1px;background:#d9e4d8}
.whoq-ic{width:150px;height:150px;margin:0 auto 18px;display:flex;align-items:center;justify-content:center;font-size:64px}
.whoq-ic .ph{width:100%;height:100%;border-radius:50%}
.whoq-ic img{width:100%;height:100%;object-fit:contain;display:block}
.whoq-name.xname{position:relative;display:flex;align-items:center;justify-content:center;min-height:118px;margin-bottom:10px}
.xname .xmark{position:absolute;z-index:1;top:50%;left:50%;transform:translate(-50%,-50%);width:108px;height:109px;max-width:none;object-fit:contain;pointer-events:none}
.xname .nt{position:relative;z-index:2}
.whoq-name{font-weight:800;font-size:21px;color:var(--navy);margin-bottom:10px;line-height:1.25}
.whoq-desc{font-size:17px;color:var(--ink);margin:0;line-height:1.55}
/* "Is For" em 4 linhas (ref. SlimSoda) — o "Is NOT For" segue no grid .n2 */
.whoq-rows{max-width:760px;margin:30px auto 0;text-align:left}
.whoq-row{display:grid;grid-template-columns:78px minmax(0,1fr);gap:18px;align-items:center;padding:18px 0;border-top:1px solid #dfeae0}
.whoq-row:first-child{border-top:0;padding-top:4px}
.whoq-ric{width:78px;height:78px;flex:0 0 auto}
.whoq-ric img{width:100%;height:100%;object-fit:contain;display:block}
.whoq-rows .whoq-name{font-size:21px;margin-bottom:4px;line-height:1.25}
.whoq-rows .whoq-desc{font-size:17px;line-height:1.5}
@media(max-width:760px){
  .whoq-rows{margin-top:20px}
  .whoq-row{grid-template-columns:56px minmax(0,1fr);gap:13px;padding:14px 0}
  .whoq-ric{width:56px;height:56px}
  .whoq-rows .whoq-name{font-size:17px;margin-bottom:3px;line-height:1.2}
  .whoq-rows .whoq-desc{font-size:15px;line-height:1.45}
}
@media(max-width:760px){
  .who-wide{padding:0 14px}
  .whoq-col{padding:10px 6px}
  /* sem divisórias no grid de 2 colunas */
  .whoq-col+.whoq-col:before{display:none}
  .whoq-ic{width:76px;height:76px;margin:0 auto 8px;font-size:36px}
  .whoq-name{font-size:15.5px;margin-bottom:6px;line-height:1.2}
  .whoq-desc{font-size:13.5px;line-height:1.4}
  .whoq-name.xname{min-height:86px}
  .xname .xmark{width:82px;height:83px}
  .xname .nt{font-size:15.5px}
}

/* ===== tabela comparativa (diagramação ref. SlimSoda) ===== */
.compare{background:var(--cream);border-top:1px solid #d9e4d8;border-bottom:1px solid #d9e4d8}
.wrap-wide2{max-width:1000px;margin:0 auto;padding:0 20px}
.compare h2.cmp-title{line-height:1.08;margin-bottom:4px;font-size:clamp(29px,5vw,44px)}
.cmp2{margin-top:26px;position:relative}
.cmp2-head,.cmp2-row{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;align-items:center}
.cmp2-head{align-items:end}
/* células esticam: se ficarem centradas, o border-top de cada uma nasce numa altura
   diferente (conforme o texto quebra) e o separador sai picotado */
.cmp2-row{align-items:stretch}
.cmp2-row:nth-child(even){background:#fff}
.ch{text-align:center;padding:0 6px 14px}
.ch.cl{padding:0}
.ch-prod{height:120px;width:auto;object-fit:contain;display:block;margin:0 auto 6px}
.ch-ic{display:flex;align-items:center;justify-content:center;height:120px}
.ch-ic svg,.ch-ic img{width:76px;height:76px;object-fit:contain;opacity:.62}
.ch-nm{display:block;font-weight:800;font-size:15.5px;color:var(--navy);line-height:1.2}
.ch.ours .ch-nm{color:#fff}
.cmp2 .ours{position:relative}
.cmp2 .ours:before{content:"";position:absolute;left:6px;right:6px;top:0;bottom:0;background:#2A7A54;z-index:0}
.cmp2-head .ours{padding-top:18px}
.cmp2-head .ours:before{top:0;border-radius:18px 18px 0 0}
.cmp2-row .ours{align-self:stretch;display:flex;align-items:center;justify-content:center}
.cmp2-row .ours:before{top:-1px;bottom:0}
.cmp2-row:last-child .ours:before{bottom:-16px;border-radius:0 0 18px 18px}
.cmp2 .ours>*{position:relative;z-index:1}
.cmp2-row .cl,.cmp2-row .cc:not(.ours){border-top:1px solid #dfeee4}
.cmp2-row .cl{display:flex;align-items:center;text-align:left;font-weight:700;font-size:17px;color:var(--ink);padding:18px 14px 18px 16px}
.cc{display:flex;align-items:center;justify-content:center;text-align:center;padding:14px 6px}
.cbg{width:46px;height:46px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;color:#fff;line-height:1;vertical-align:middle}
.cbg svg{width:52%;height:52%;fill:none;stroke:currentColor;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
.cbg.yes{background:linear-gradient(180deg,#2FCB63,#12A84A);box-shadow:0 2px 7px rgba(18,168,74,.26)}
.cbg.no{background:var(--navy)}
.cbg.mid{background:#8E9B8B}
.ours .cbg.yes{background:#fff;color:#12A84A;box-shadow:none}
.cmp-legend{margin-top:34px;display:flex;flex-wrap:wrap;justify-content:center;gap:14px 30px}
.cmp-legend .lg{display:inline-flex;align-items:center;gap:9px;font-weight:700;font-size:15px;color:var(--ink)}
.cmp-legend .lg .cbg{width:30px;height:30px}
/* --- selos "livre de" (grid circular, ref. SlimSoda) --- */
.nogrid{margin-top:34px;display:grid;grid-template-columns:repeat(3,1fr);gap:30px 12px}
.nb{text-align:center}
.nb-ic{position:relative;width:88px;height:88px;margin:0 auto 12px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 12px rgba(18,60,42,.07)}
.nb-ic img{width:56px;height:56px;max-width:none;object-fit:contain;display:block}
/* ícones sem o traço de proibição embutido — traço aplicado via CSS */
.nb-ic.slash img{width:44px;height:44px}
.nb-ic.slash:after{content:"";position:absolute;left:50%;top:50%;width:62px;height:2.5px;border-radius:3px;background:var(--navy);transform:translate(-50%,-50%) rotate(-45deg)}
.nb-t{display:block;font-weight:800;font-size:16px;line-height:1.25;color:var(--navy);max-width:155px;margin:0 auto}
@media(max-width:640px){
  .cmp-legend{margin-top:26px;gap:8px 18px}
  .cmp-legend .lg{font-size:12.5px;gap:6px}
  .cmp-legend .lg .cbg{width:24px;height:24px}
  .wrap-wide2{padding:0 10px}
  .cmp2-head,.cmp2-row{grid-template-columns:1.35fr .88fr .88fr .88fr}
  .ch-prod{height:64px}
  .ch-ic{height:64px}.ch-ic svg,.ch-ic img{width:44px;height:44px}
  .ch-nm{font-size:11px}
  .cmp2-row .cl{font-size:13.5px;padding:14px 6px 14px 8px}
  .cbg{width:34px;height:34px}
  .cmp2 .ours:before{left:3px;right:3px}
  .nogrid{margin-top:26px;gap:22px 8px}
  .nb-ic{width:66px;height:66px;margin-bottom:8px}
  .nb-ic img{width:42px;height:42px}
  .nb-ic.slash img{width:33px;height:33px}
  .nb-ic.slash:after{width:47px;height:2px}
  .nb-t{font-size:13px;max-width:110px}
}

/* ===== expect timeline (ref. prnt.sc oK4Nm4cprST5 / noralife) ===== */
.expect{background:var(--cream-2)}
/* timeline de resultados (ref. SlimSoda) — trilho preenche conforme a rolagem */
.tl{margin-top:28px;position:relative;padding-left:52px}
/* trilho fica SEMPRE abaixo dos nós — sem z-index o :after (último filho) pinta por cima */
.tl:before,.tl:after{content:"";position:absolute;left:12.5px;top:10px;width:5px;border-radius:12px;z-index:0}
.tl:before{bottom:10px;background:#DCE9E0}
.tl:after{height:var(--tlp,0px);max-height:calc(100% - 20px);
  background-image:linear-gradient(180deg,#87E64B 0%,#1FA45C 45%,#12A84A 100%);
  background-repeat:no-repeat;background-size:100% var(--tlh,100%);
  transition:height .2s linear}
.tl-item{position:relative;margin-bottom:26px}
.tl-item:last-child{margin-bottom:0}
.tl-head{position:relative;display:flex;align-items:center;gap:12px;min-height:36px;margin-bottom:12px}
.tl-node{position:absolute;z-index:2;left:-52px;top:50%;transform:translateY(-50%);width:30px;height:30px;border-radius:50%;
  background:#C9DCD0;display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 0 5px var(--cream-2);transition:background .3s ease,transform .3s ease}
.tl-node svg{width:14px;height:14px;fill:none;stroke:#fff;stroke-width:3.4;stroke-linecap:round;stroke-linejoin:round}
.tl-item.lit .tl-node{background:linear-gradient(180deg,#2FCB63,#12A84A);transform:translateY(-50%) scale(1.08)}
.tl-cal{width:34px;height:34px;max-width:none;object-fit:contain;flex:0 0 auto;display:block}
.tl-item h4{font-family:'DM Serif Display',Georgia,serif;font-weight:400;letter-spacing:.2px;font-size:25px;color:var(--navy);text-transform:none;margin:0}
.tl-card{background:#F4FBF6;border:1px solid #CBE7D6;border-radius:12px;padding:16px 20px}
.tl-card ul{margin:0}
.tl-item li{list-style:none;display:flex;gap:9px;padding:5px 0;font-size:16.5px}
.tl-item li .d{color:var(--green);flex:0 0 auto;font-weight:900}
@media(prefers-reduced-motion:reduce){.tl:after,.tl-node{transition:none}}

/* ===== oferta estilo Infinite Age (ref. infiniteage.com/pages/lp2#package) ===== */
.offer{background:var(--cream)}
.offer-top{max-width:1020px;margin:0 auto 22px;padding:0 18px}
.warn-card{display:flex;align-items:center;justify-content:center;gap:16px 26px;flex-wrap:wrap;background:#fff;border:1.5px solid #e0e9dd;border-radius:12px;padding:18px 24px;text-align:center;box-shadow:0 2px 7px rgba(30,61,43,.10);margin:0}
.warn-card .wi{font-size:30px;line-height:1;flex:0 0 auto}
.warn-card .wt{font-family:'Inter',Arial,sans-serif;font-weight:600;letter-spacing:1.5px;font-size:26px;color:var(--red);text-transform:uppercase;line-height:1}
.warn-card .wc{font-weight:800;font-size:18px;color:var(--ink)}
.warn-card .wc b{color:var(--red);font-size:22px}
@media(max-width:640px){.warn-card{gap:8px 16px;padding:14px 16px}.warn-card .wt{font-size:20px}.warn-card .wc{font-size:15.5px}.warn-card .wc b{font-size:18px}}
.offer-wrap{display:grid;grid-template-columns:.86fr 1.14fr;gap:26px;max-width:1080px;margin:0 auto;align-items:start;padding:0 18px}
.offer-wrap>div{min-width:0}
@media(max-width:899px){.offer-wrap{grid-template-columns:1fr;max-width:560px;gap:18px}}
.offer-left{display:flex;flex-direction:column;justify-content:flex-start;background:#fff;border:1px solid #e0e9dd;border-radius:12px;padding:16px;box-shadow:0 2px 7px rgba(30,61,43,.10)}
.offer-right{display:flex;flex-direction:column;justify-content:center}
.gal-main{background:transparent;border:none;border-radius:12px;padding:0}
.gal-main img{width:100%;display:block;border-radius:12px;aspect-ratio:1/1;object-fit:cover}
.gal-thumbs{display:flex;gap:8px;margin-top:10px;justify-content:center;flex-wrap:nowrap}
.gal-thumbs button{border:2px solid #cfdccb;background:#fff;border-radius:12px;padding:4px;cursor:pointer;flex:1 1 0;min-width:0;max-width:62px;aspect-ratio:1/1}
.gal-thumbs button.on{border-color:var(--orange)}
.gal-thumbs img{width:100%;height:100%;object-fit:cover;display:block;border-radius:8px}
.offer-rate{text-align:center;margin-top:14px;font-weight:800;color:var(--navy);font-size:15px}
.gold-banner{background:linear-gradient(135deg,#F6D98A,#E2A72E 45%,#F3CE6B);border:1px solid #c9962f;border-radius:12px;text-align:center;padding:16px 14px;color:#3a2c07;margin-bottom:22px;box-shadow:0 2px 7px rgba(201,150,47,.28)}
.gold-banner .g1{font-family:'Inter',Arial,sans-serif;font-size:27px;letter-spacing:1px;line-height:1.05}
.gold-banner .g2{font-weight:700;font-size:16.5px;margin-top:6px}
.ltd-card{background:#EDF6EF;border:1px solid #bcd9c4;border-radius:12px;padding:22px 20px 12px;position:relative;margin-bottom:18px}
.ltd-pill{position:absolute;top:-15px;left:50%;transform:translateX(-50%);background:var(--orange-2);color:var(--navy);font-weight:800;font-size:13px;letter-spacing:1px;text-transform:uppercase;padding:6px 18px;border-radius:12px;white-space:nowrap;box-shadow:0 3px 8px rgba(0,0,0,.15)}
.ltd-row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 0 12px;border-bottom:1px solid #cfe3d4;flex-wrap:wrap}
.ltd-name{font-weight:800;font-size:18.5px;color:var(--ink)}
.ltd-price .old{color:#7a8577;text-decoration:line-through;font-weight:700;font-size:17px;margin-right:8px}
.ltd-price .new{color:var(--red);font-weight:800;font-size:27px}
.ltd-perk{display:flex;gap:12px;align-items:center;padding:12px 0;font-weight:700;font-size:16.5px;border-bottom:1px solid #cfe3d4;color:var(--ink)}
.ltd-perk:last-child{border-bottom:none}
.ltd-perk .pi{font-size:27px;flex:0 0 auto}
.ship-note{text-align:center;font-weight:700;margin:12px 0 0;color:var(--navy)}
.offer-right .official{margin-top:16px;text-align:center;font-size:14.5px;font-weight:700;color:var(--navy-2)}
.offer-right .official b{color:var(--navy)}
/* 152px = 280 × (456/840): a arte foi de 4 para 2 bandeiras, e este max-width mantém
   cada cartão exatamente do tamanho que tinha. Com os 280px antigos os dois cresceriam 1,8×. */
.pay-ph{display:block;width:100%;max-width:152px;height:auto;margin:14px auto 0;object-fit:contain}
/* ===== oferta estilo SlimSoda: sem preço, bullets + lotes + CTA ===== */
.of-rate{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:14.5px;color:var(--navy-2);margin-bottom:10px}
.of-stars{color:#2FA968;letter-spacing:1px;font-size:15px}
.of-rate b{color:var(--ink)}
.of-sep{color:#bcd0c2}
.of-head{font-family:'DM Serif Display',Georgia,serif;font-weight:400;font-size:clamp(24px,2.6vw,34px);line-height:1.14;color:var(--navy);margin:0 0 16px;letter-spacing:0}
.of-list{list-style:none;padding:0;margin:0 0 18px}
.of-list li{display:flex;gap:11px;align-items:flex-start;font-weight:700;font-size:clamp(15px,1.35vw,17px);color:var(--ink);line-height:1.35;padding:9px 0;border-bottom:1px solid #e0ece2}
.of-list li:last-child{border-bottom:none}
.of-ck{flex:0 0 auto;width:23px;height:23px;max-width:none;object-fit:contain;margin-top:-1px}
.of-batch{background:#fff;border:1px solid #dceade;border-radius:12px;padding:16px 16px 14px;box-shadow:0 2px 8px rgba(30,61,43,.07)}
.of-batch-h{font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:17px;color:var(--navy);text-transform:uppercase;letter-spacing:.4px}
.of-batch-s{margin:4px 0 12px;font-size:14px;color:var(--navy-2)}
/* lotes: só vermelho e cinza. O cinza é o trilho, o rosa é o quanto já vendeu (--fill) */
.of-b-row{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:10px;border-radius:9px;padding:13px 14px;margin-bottom:8px;font-weight:700;font-size:14.5px;background:#ECECEC;color:var(--ink)}
.of-b-row:last-child{margin-bottom:0}
.of-b-row:before{content:"";position:absolute;left:0;top:0;bottom:0;width:var(--fill,0%);background:#FBD5D2}
/* os filhos precisam ser posicionados para ficar ACIMA do preenchimento */
.of-b-row>*{position:relative}
.of-b-row .d{display:inline-flex;align-items:center;gap:9px;min-width:0}
/* mesmo calendário da timeline (tl-calendar.webp) — arte colorida, não recolorir */
.of-b-row .cal{width:19px;height:19px;flex:0 0 auto;max-width:none;object-fit:contain;display:block}
.of-b-row .tag{white-space:nowrap;font-weight:800}
.of-b-row.sold{--fill:100%}
.of-b-row.sold .tag{color:#D6211A}
/* tampa vermelha na ponta do lote esgotado (recortada pelo overflow do pai) */
.of-b-row.sold:after{content:"";position:absolute;right:0;top:0;bottom:0;width:9px;background:#E2231A}
.of-b-row.next{--fill:0%}
.of-stock{display:flex;align-items:center;justify-content:center;gap:7px;margin:14px 0 12px;font-size:13.5px;font-weight:700;color:var(--navy-2)}
.of-stock .dot{width:8px;height:8px;border-radius:50%;background:#2FA968;flex:0 0 auto}
.of-cta{display:flex;align-items:center;justify-content:center;gap:.4em;text-align:center;width:100%;box-sizing:border-box;background:linear-gradient(180deg,#9BF25C 0%,#63D62F 100%);color:var(--navy);text-decoration:none;font-family:'Inter',Arial,sans-serif;font-weight:800;text-transform:uppercase;letter-spacing:.1px;font-size:clamp(11.5px,1.55vw,19px);line-height:1.15;white-space:nowrap;padding:18px 14px;border-radius:999px;box-shadow:0 8px 20px rgba(135,230,75,.42);transition:transform .12s ease,filter .2s}
.of-cta:hover{transform:translateY(-2px);filter:brightness(1.05)}
.of-cta .arr{margin-left:.35em}
.of-guar{display:flex;align-items:center;justify-content:center;gap:7px;margin:12px 0 0;font-size:13.5px;font-weight:700;color:var(--navy-2)}
@media(max-width:640px){
  .of-head{font-size:23px}
  .of-list li{font-size:15px;padding:8px 0}
  .of-cta{font-size:clamp(10.5px,3.05vw,15px);padding:16px 10px}
  .of-b-row{font-size:13px;padding:11px 12px;gap:8px}
  .of-b-row .d{gap:7px}
  .of-b-row .cal{width:16px;height:16px}
  .of-b-row.sold:after{width:7px}
  .of-batch-h{font-size:15.5px}
}
@media(max-width:640px){.gold-banner .g1{font-size:23px}.ltd-name{font-size:16.5px}.ltd-price .new{font-size:24px}}

/* ===== guarantee ===== */
.guarantee{padding:44px 18px;background:var(--cream-2)}
.g-card{max-width:940px;margin:0 auto;border:2px solid var(--navy);border-radius:6px;overflow:hidden}
.g-top{background:var(--cream);display:flex;align-items:center;justify-content:space-between;gap:22px;padding:24px 30px}
.g-head{color:var(--navy);margin:0;font-size:clamp(25px,3.5vw,40px);line-height:1.06;letter-spacing:.3px;text-align:left;text-transform:uppercase;font-weight:800;flex:1 1 auto;min-width:0}
.g-bot{background:var(--navy);padding:28px 30px 24px}
.g-seal{width:clamp(88px,11vw,132px);height:auto;flex:0 0 auto;margin:0;display:block}
.g-copy{color:#fff;margin:0 0 22px;font-size:clamp(16.5px,1.95vw,21px);line-height:1.45;font-weight:600;text-align:left}
.g-cta{display:flex;align-items:center;justify-content:center;gap:.5em;text-align:center;width:100%;box-sizing:border-box;background:linear-gradient(180deg,#9BF25C 0%,#63D62F 100%);color:var(--navy);text-decoration:none;font-family:'Inter',Arial,sans-serif;font-weight:800;letter-spacing:.2px;text-transform:uppercase;font-size:clamp(14px,2.35vw,26px);line-height:1.1;white-space:nowrap;padding:17px 18px;border-radius:999px;transition:filter .2s}
.g-cta:hover{filter:brightness(1.07)}
.g-reassure{display:flex;align-items:center;justify-content:center;gap:8px;color:#cfdccb;font-weight:700;font-size:15px;margin-top:16px;text-align:center}
@media(max-width:640px){
  .guarantee{padding:30px 14px}
  .g-top{flex-direction:row;align-items:center;gap:10px;padding:18px 10px}
  .g-head{font-size:21px;line-height:1.12}
  .g-br{display:none}
  .g-seal{width:clamp(72px,24vw,104px)}
  .g-bot{padding:22px 18px 20px}
  .g-copy{font-size:16px;margin-bottom:18px}
  .g-cta{font-size:clamp(11px,3.35vw,20px);padding:15px 10px;letter-spacing:0}
  .g-reassure{font-size:13px}
}

/* ===== social proof strip ===== */
.sproof{padding:0}
/* faixa UGC: marquee infinito. 2 conjuntos idênticos + translateX(-50%) = laço sem emenda */
.sp-mq{overflow:hidden;line-height:0;position:relative}
.sp-track{display:flex;width:max-content;animation:spScroll 55s linear infinite;will-change:transform}
.sp-mq:hover .sp-track{animation-play-state:paused}
.sp-set{display:flex;flex:0 0 auto}
.sp-set img{width:clamp(150px,12.5vw,190px);aspect-ratio:1/1;object-fit:cover;display:block;flex:0 0 auto}
.sp-set .ph{width:clamp(150px,12.5vw,190px);aspect-ratio:1/1;border-radius:0;border:1px dashed var(--ph-line);min-height:0;font-size:9px;letter-spacing:.5px;flex:0 0 auto}
@keyframes spScroll{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}
@media(prefers-reduced-motion:reduce){.sp-track{animation:none}}
.sp-bar{background:var(--navy);color:#fff}
.sp-bar .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:10px 30px;padding-top:13px;padding-bottom:13px;max-width:1000px}
.sp-b{display:inline-flex;align-items:center;gap:9px;font-weight:800;font-size:15px;letter-spacing:.2px}
.sp-b svg{width:21px;height:21px;stroke:#fff;fill:none;stroke-width:2;stroke-linecap:round}
@media(max-width:640px){.sp-strip{grid-template-columns:repeat(6,1fr)}.sp-bar .wrap{gap:8px 16px;padding:11px 14px}.sp-b{font-size:12.5px;gap:7px}.sp-b svg{width:17px;height:17px}}

/* ===== reviews (estilo Facebook / Judge.me) ===== */
.rvw{background:#fff;padding:0}
.rvw-in{max-width:1000px;margin:0 auto;padding:40px 20px 48px}
.rvw-top{display:grid;grid-template-columns:auto 1fr;gap:26px;align-items:center;padding-bottom:22px}
.rvw-score{text-align:center}
.rs-num{font-size:52px;font-weight:800;color:var(--ink);line-height:1}
.rs-stars{color:#f5b301;font-size:22px;letter-spacing:2px;margin-top:2px}
.rs-sub{color:#666;font-size:13.5px;margin-top:6px}
.rvw-bars{max-width:320px;width:100%}
.bar-row{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;margin:2px 0}
.bstars{color:#c9ccd1;font-size:12px;letter-spacing:1px;white-space:nowrap}
.btrack{height:9px;background:#ececec;border-radius:2px;overflow:hidden}
.bfill{display:block;height:100%;background:#f5b301}
.bcount{color:#888;font-size:12.5px;min-width:30px;text-align:right}
.rvw-tabs{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e4e4e4;margin-bottom:6px}
.rt-active{font-weight:700;color:var(--ink);padding:12px 2px;border-bottom:3px solid var(--navy);margin-bottom:-1px}
.rt-active b{font-weight:700;margin-left:6px}
.rt-sort{border:1px solid #d5d5d5;border-radius:12px;padding:8px 12px;font-size:13.5px;color:#444}
.rev{border-bottom:1px solid #ededed;padding:24px 0}
.rev-head{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:start}
.av{position:relative;width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;color:#3a4658;background:#e2e6ea}
.av1{background:#dfeae2}.av2{background:#e8efdc}.av3{background:#f0e6da}.av4{background:#dde6ef}
.av-ck{position:absolute;right:-2px;bottom:-2px;width:18px;height:18px;border-radius:50%;background:#2c9c5d;color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center;border:2px solid #fff}
.rev-name{font-weight:700;color:var(--ink);font-size:15.5px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.vb{color:#2c9c5d;font-weight:600;font-size:13px}
.vshop{color:#777;font-weight:500;font-size:12.5px;background:#f2f2f2;padding:2px 7px;border-radius:12px}
.vshop b{color:#444}
.rev-loc{display:flex;align-items:center;gap:6px;color:#666;font-size:13px;margin-top:4px}
.flag{width:19px;height:13px;border:1px solid #ddd;border-radius:1px;display:block}
.rev-date{color:#9a9a9a;font-size:13px;white-space:nowrap}
.rev-stars{color:#f5b301;font-size:17px;letter-spacing:1px;margin:14px 0 6px}
.rev-title{font-weight:700;color:var(--ink);font-size:15.5px;margin-bottom:5px}
.rev-body{color:#333;font-size:15px;line-height:1.55}
.rev-share{display:inline-flex;align-items:center;gap:6px;color:#666;font-size:13px;text-decoration:none;margin-top:14px}
@media(max-width:640px){.rev-head{grid-template-columns:auto 1fr;gap:12px}.rev-date{grid-column:2;order:3;margin-top:2px}.rev-name{font-size:14.5px}}
.rvw-img{width:100%;max-width:560px;display:block;margin:0 auto 26px;border-radius:12px}
@media(max-width:640px){.rvw-in{padding:28px 14px 34px}.rvw-top{grid-template-columns:1fr;gap:18px;text-align:center}.rvw-score{display:flex;align-items:center;justify-content:center;gap:14px}.rs-sub{margin-top:0}.rvw-bars{max-width:none;margin:0 auto}}

/* ===== faq ===== */
.faq{background:#fff;border-top:1px solid #d9e4d8}
.faq-group{font-family:'Inter',Arial,sans-serif;font-weight:600;font-size:26px;color:var(--red);text-transform:uppercase;margin:30px 0 10px;letter-spacing:1.5px}
details.qa{background:var(--cream-2);border:1px solid #e0e9dd;border-radius:12px;margin-bottom:10px;overflow:hidden}
details.qa summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:14px;align-items:center;padding:16px 18px;font-weight:800;font-size:18px;color:var(--navy)}
details.qa summary::-webkit-details-marker{display:none}
details.qa summary:after{content:"+";font-size:26px;color:var(--orange);flex:0 0 auto;font-weight:400}
details.qa[open] summary:after{content:"–"}
details.qa .a{padding:0 18px 18px;font-size:17px;color:var(--ink)}

/* ===== footer ===== */
footer{background:var(--navy);color:#a7bbaa;padding:44px 0 120px;font-size:13.5px;text-align:center}
footer p{margin:0 0 12px;line-height:1.6}
.logo-img{height:46px;display:block}
.logo-foot{height:46px;filter:brightness(0) invert(1);opacity:.9;margin:0 auto 14px}


/* header rating */
.hdr-in{display:flex;align-items:center;justify-content:space-between;gap:14px}
.hdr-logo{height:34px;width:auto;display:block}
.hdr-cta{flex:0 0 auto;display:inline-flex;align-items:center;gap:9px;background:linear-gradient(180deg,#2FCB63 0%,#12A84A 100%);color:#fff;text-decoration:none;font-weight:800;font-size:16px;padding:11px 22px;border-radius:999px;box-shadow:0 4px 12px rgba(0,173,33,.32);transition:transform .12s ease,filter .2s}
.hdr-cta:hover{transform:translateY(-1px);filter:brightness(1.06)}
.hdr-cta .arr{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,.28);font-size:15px;line-height:1}

/* reveal animation */
html.js .rv{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease}
html.js .rv.on{opacity:1;transform:none}

/* ===== OTIMIZAÇÃO MOBILE-FIRST (90%+ do tráfego é mobile) ===== */
img,svg{max-width:100%}
@media(max-width:640px){
  body{font-size:17px;line-height:1.5}
  section{padding:30px 0}
  .wrap{padding:0 14px}
  .topbar{font-size:11.5px;padding:7px 10px}
  header.site{padding:12px 0}
  .hdr-logo{height:28px}
  .hdr-cta{font-size:14px;padding:9px 16px;gap:7px}
  .hdr-cta .arr{width:19px;height:19px;font-size:13px}
  h1.display{font-size:34px}
  h2.display{font-size:27px}
  .hl-h3{font-size:24px}
  .sec-sub{font-size:16.5px}
  .kicker{font-size:12px}
  .btn{font-size:18px;padding:17px 18px;border-radius:999px}
  .under-btn{font-size:13.5px}
  .ph-md{min-height:180px}.ph-lg{min-height:230px}
  .arrlist li,.dotlist li{font-size:16px;padding:8px 0}
  .xlist{gap:10px;margin:20px 0}
  .xlist li{font-size:15px;padding:12px 13px;gap:9px}
  .quotebig{font-size:18px}
  .qbox{margin:20px 0}
  .qbox-h{font-size:15.5px;padding:11px 14px}
  .qbox-q{font-size:15.5px;padding:13px 14px}
  .greenbox{font-size:16px;padding:16px}
  .force{font-size:15px;padding:13px 14px;gap:10px}
  .split{gap:14px;margin:20px 0}
  .born{padding:36px 0}
  .born .sub{font-size:17px}
  .ing-head .nm{font-size:20px}
  .ing-desc{font-size:15.5px}
  .ing-bd li{font-size:14.5px}
  .steps-hero{max-width:190px;margin-top:8px}
  .stp{grid-template-columns:44px minmax(0,1fr);gap:13px;padding-bottom:22px}
  .stp:not(:last-child):before{left:21px;top:46px}
  .stp-ic{width:44px;height:44px}
  .stp-ic svg{width:22px;height:22px}
  .stp-hd{min-height:44px;gap:8px}
  .stp-nm{font-size:22px}
  .stp-tag{font-size:11.5px;padding:5px 10px}
  .stp p{font-size:15.5px}
  .steps .close{font-size:17.5px}
  .tl{padding-left:44px}
  .tl:before,.tl:after{left:10.5px}
  .tl-item{padding:0;margin-bottom:20px}
  .tl-item li{font-size:15.5px}
  .tl-head{gap:9px;min-height:32px;margin-bottom:10px}
  .tl-node{left:-44px;width:26px;height:26px;box-shadow:0 0 0 4px var(--cream-2)}
  .tl-node svg{width:12px;height:12px}
  .tl-cal{width:28px;height:28px}
  .tl-item h4{font-size:22px}
  .tl-card{padding:14px 16px}
  .whoq-name{font-size:17px}
  .whoq-desc{font-size:15px}
  details.qa summary{font-size:16px;padding:14px}
  details.qa .a{font-size:15.5px;padding:0 14px 14px}
  footer{padding:34px 0 104px;font-size:12.5px}
}
@media(max-width:360px){
  .hl-h3{font-size:21px}
  .marker{padding:2px 3px}
  .maya-title{font-size:26px}
  h1.display{font-size:30px}
  h2.display{font-size:24px}
}
</style>
<style>
/* ===== HERO (grid duas colunas; sem arte full-bleed — ver IMAGE-BRIEF 02-hero-desktop) ===== */
.hero{background:var(--cream);padding:32px 0 40px}
.herolp{display:grid;grid-template-columns:1.16fr .84fr;column-gap:34px;max-width:1140px;margin:0 auto;padding:0 20px;align-items:center}
.herolp>*{min-width:0}
.hl-top{grid-column:1;grid-row:1;align-self:end}
.hl-bottom{grid-column:1;grid-row:2;align-self:start;padding-top:14px}
.hl-img{grid-column:2;grid-row:1 / span 2;align-self:center}
.hl-img img{width:100%;max-width:none;display:block;margin:0 auto;filter:none}
/* rating estilo Trustpilot */
.tp-rate{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:15px;color:var(--ink);margin:0 0 16px}
.tp-stars{display:inline-flex;gap:2px}
.tp-stars i{width:22px;height:22px;background:#1FA45C;color:#fff;font-style:normal;font-size:13px;line-height:22px;text-align:center;border-radius:2px}
.tp-rate b{font-weight:800}
.tp-sep{color:#c2d4c8}
.hl-eyebrow{font-style:italic;font-weight:600;font-size:clamp(16px,1.5vw,19px);color:var(--navy-2);margin:0 0 10px}
.hl-h1{font-family:'DM Serif Display',Georgia,serif;font-weight:400;font-size:clamp(28px,3.15vw,45px);line-height:1.1;color:var(--navy);margin:0 0 18px;text-align:left;letter-spacing:0}
.hl-h1 .accent{color:var(--red)}
.hl-underline{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:5px}
/* barra de selos escuros com as estatísticas */
.hl-pills{display:flex;flex-wrap:nowrap;align-items:center;justify-content:center;background:#0E3324;border-radius:7px;padding:6px 2px;margin:0 0 20px;width:100%}
/* o teto é 17,5px: acima de ~1500px o contêiner do hero para de crescer (728px em 1920) */
.hl-pills span{color:#fff;font-weight:700;font-size:clamp(9.5px,1.18vw,17.5px);padding:2px clamp(5px,.85vw,15px);white-space:nowrap;line-height:1.2;position:relative;flex:0 1 auto;min-width:0}
.hl-pills span+span:before{content:"";position:absolute;left:0;top:50%;transform:translateY(-50%);height:15px;width:1px;background:rgba(255,255,255,.24)}
.hl-pills b{font-weight:800;color:#87E64B}
.hl-pills i{font-style:normal}
/* card flutuante de depoimento sobre a arte */
.hl-img{position:relative}
.hl-badge{position:absolute;bottom:5%;left:-9%;z-index:3;display:flex;align-items:center;gap:12px;background:#fff;border:1px solid #e2eee5;border-radius:14px;padding:8px 16px 8px 8px;box-shadow:0 10px 26px rgba(18,60,42,.18);max-width:310px}
.hl-img .hl-badge>img{width:72px;height:72px;min-width:72px;max-width:72px;border-radius:10px;object-fit:cover;flex:0 0 auto;aspect-ratio:auto;object-position:center}
.hb-big{font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:17px;color:var(--navy);line-height:1.15;display:block}
.hb-ar{color:var(--red);font-weight:900;margin-right:3px}
.hb-sub{font-size:11.5px;color:var(--navy-2);font-weight:600;line-height:1.3;margin-top:3px}
.hb-nm{font-size:12.5px;color:var(--red);font-weight:800;margin-top:4px}
.hl-sub{font-size:clamp(16px,1.5vw,19px);color:var(--ink);line-height:1.5;margin:0 0 10px}
.hl-lead{font-weight:700;font-size:clamp(16px,1.6vw,19px);color:var(--ink);margin:0 0 16px;line-height:1.4}
.hl-list{list-style:none;padding:0;margin:0 0 16px}
.hl-list li{display:flex;gap:12px;align-items:flex-start;font-weight:400;font-size:clamp(15.5px,1.45vw,18px);color:var(--ink);line-height:1.4;padding:11px 0;border-bottom:1px solid #e6efe8}
.hl-list li:last-child{border-bottom:none}
.hl-list li b{font-weight:800}
.hl-ck2{flex:0 0 auto;width:23px;height:23px;border-radius:50%;background:#1FA45C;color:#fff;font-size:13px;font-weight:900;display:inline-flex;align-items:center;justify-content:center;margin-top:1px}
.hl-ck{flex:0 0 auto;width:28px;height:28px;max-width:none;object-fit:contain;display:inline-block;margin-top:-1px}
.hl-urg{display:flex;align-items:center;justify-content:center;gap:8px;font-size:14px;font-weight:600;color:var(--navy-2);margin:0 0 12px}
.hl-urg .dot{width:8px;height:8px;border-radius:50%;background:#1FA45C;flex:0 0 auto;position:relative;animation:pulseDot 1.4s ease-in-out infinite}
.hl-urg .dot:after{content:"";position:absolute;inset:0;border-radius:50%;background:#1FA45C;animation:pulseRing 1.4s ease-out infinite}
@keyframes pulseDot{0%,100%{opacity:1}50%{opacity:.45}}
@keyframes pulseRing{0%{transform:scale(1);opacity:.55}70%,100%{transform:scale(2.6);opacity:0}}
@media(prefers-reduced-motion:reduce){.hl-urg .dot,.hl-urg .dot:after{animation:none}}
.hl-cta .arr{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,.25);margin-left:.5em;font-size:18px;line-height:1}
.hl-cta{display:block;width:100%;max-width:470px;box-sizing:border-box;background:linear-gradient(180deg,#2FCB63 0%,#12A84A 100%);color:#fff;text-decoration:none;text-align:center;font-weight:800;font-size:clamp(18px,1.9vw,23px);padding:18px 22px;border-radius:999px;box-shadow:0 6px 16px rgba(35,95,59,.4);transition:transform .12s ease}
.hl-cta:hover{transform:translateY(-1px)}
.hl-cta .arr{margin-left:.3em}
.hl-trust{margin-top:14px;display:flex;flex-direction:column;gap:7px}
.hl-guar{display:flex;align-items:center;gap:8px;color:var(--navy-2);font-weight:600;font-size:14px}
.hl-guar .shield{display:inline-flex;align-items:center;line-height:1;font-size:15px}
/* ===== HERO desktop: 2 colunas — texto à esquerda, composto à direita (estilo SlimSoda) ===== */
@media(min-width:861px){
  /* 2 colunas: texto à esquerda, composto à direita (estilo SlimSoda) */
  .hero{background:var(--cream);display:block;padding:36px 0 46px;overflow:hidden}
  .herolp{display:grid;grid-template-columns:1.08fr .92fr;column-gap:28px;max-width:1440px;width:100%;margin:0 auto;padding:0 32px;align-items:center}
  .hl-top{grid-column:1;grid-row:1;align-self:end;max-width:none;text-align:left}
  .hl-bottom{grid-column:1;grid-row:2;align-self:start;max-width:none;padding-top:6px}
  .hl-img{grid-column:2;grid-row:1 / span 2;align-self:center;display:block;width:108%;margin:0 -8% 0 0}
  /* recorta só o composto da arte 3150×1300 (conteúdo em 51%–84% da largura) */
  .hl-img img{width:100%;max-width:none;display:block;aspect-ratio:1124/1091;object-fit:cover;object-position:77.1% 49.8%}
  /* card exatamente ao lado do botão */
  .hl-badge{bottom:-2.52%;left:-43.2%}
  /* urgência e garantia centralizadas sobre o botão, que fica à esquerda */
  .hl-cta{max-width:440px;margin:0}
  .hl-urg{justify-content:center;max-width:440px;margin-left:0;margin-right:auto}
  .hl-trust{align-items:center;text-align:center;max-width:440px;margin-left:0;margin-right:auto}
}
@media(max-width:860px){
  .hero{padding:0 0 30px}
  .herolp{grid-template-columns:1fr;column-gap:0;position:relative}
  /* texto em fluxo normal: nunca colide com a arte em nenhuma largura */
  .herolp{padding:0 12px}
  .hl-top{position:static;grid-column:1;grid-row:1;text-align:left;padding:22px 6px 6px}
  .tp-rate{justify-content:flex-start}
  /* selos em uma linha só, com todas as palavras: barra ocupa a largura toda */
  .hl-pills{width:calc(100% + 12px);margin-left:-6px;padding:5px 2px;justify-content:space-between;border-radius:7px}
  .hl-pills span{font-size:clamp(8px,2.5vw,14px);padding:2px clamp(3px,1.15vw,10px);letter-spacing:-.15px}
  /* card idêntico ao desktop, apenas reposicionado */
  .hl-badge{top:auto;bottom:-16%;left:50%;transform:translateX(-50%);width:min(310px,92vw);max-width:min(310px,92vw);padding:8px 16px 8px 8px;gap:12px}
  .hl-h1{font-size:27px;line-height:1.18;margin-bottom:14px;text-align:left}
  .hl-eyebrow{font-size:14px;margin-bottom:0}
  .hl-sub{font-size:17px;line-height:1.45;margin-bottom:8px;text-align:left}
  .hl-img{grid-column:1;grid-row:2;width:100vw;margin:0 calc(50% - 50vw) 66px}
  /* corta o vazio da arte (conteúdo entre 38% e 80% da altura) e centraliza nele */
  .hl-img img{width:100%;max-width:none;filter:none;display:block;aspect-ratio:1080/848;object-fit:cover;object-position:center 66.6%}
  .hl-bottom{grid-column:1;grid-row:3;margin-top:14px}
  .hl-lead{text-align:left}
  .hl-list li{text-align:left}
  .hl-urg{justify-content:center}
  .hl-cta{max-width:none}
  .hl-trust{align-items:center;text-align:center}
}

/* ===== [a] stats bar + depoimento destacado (ref. SkinnyFit GLP-1) ===== */
.heroext{display:grid;gap:16px;margin-top:24px}
.hx-left{display:grid;gap:16px;min-width:0}
.statsbar{background:rgba(255,255,255,.35);backdrop-filter:blur(14px) saturate(1.15);-webkit-backdrop-filter:blur(14px) saturate(1.15);border:1px solid rgba(255,255,255,.55);box-shadow:0 8px 28px rgba(30,61,43,.10);border-radius:14px;display:grid;grid-template-columns:repeat(4,1fr);padding:14px 8px}
.stat{text-align:center;padding:6px 10px;position:relative;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px}
.stat+.stat:before{content:"";position:absolute;left:0;top:10px;bottom:10px;width:1px;background:rgba(30,61,43,.14)}
.stat .v{font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:clamp(20px,2vw,26px);color:var(--navy);line-height:1;display:block;white-space:nowrap}
.stat .l{display:block;font-size:10.5px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--navy-2);line-height:1.45;max-width:130px}
@media(max-width:640px){
  .statsbar{grid-template-columns:1fr 1fr;row-gap:12px;padding:14px 6px}
  .stat:nth-child(3):before{display:none}
}
.herotesti{background:rgba(255,250,238,.42);backdrop-filter:blur(14px) saturate(1.15);-webkit-backdrop-filter:blur(14px) saturate(1.15);border:1px solid rgba(255,255,255,.55);box-shadow:0 8px 28px rgba(30,61,43,.10);border-radius:14px;padding:12px 14px;display:grid;grid-template-columns:78px minmax(0,1fr);gap:14px;align-items:center}
.ht-ph{width:78px;height:82px}
.ht-ph img{width:100%;height:100%;object-fit:cover;border-radius:10px;display:block}
.ht-top{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.ht-stars{color:#F5A623;font-size:13px;letter-spacing:1.5px}
.ht-ver{color:#2c9c5d;font-weight:800;font-size:11px;letter-spacing:1.5px;text-transform:uppercase}
.ht-ver:before{content:"✓ "}
.ht-q{font-weight:800;font-style:italic;font-size:clamp(16px,1.6vw,18.5px);color:var(--ink);margin:5px 0 4px;line-height:1.35}
.ht-n{font-size:13.5px;color:#6d6a58}
.ht-n b{color:var(--ink)}

/* ===== [b] next batch (ref. Evident Wellness) ===== */
.nextbatch{background:rgba(255,255,255,.32);backdrop-filter:blur(14px) saturate(1.15);-webkit-backdrop-filter:blur(14px) saturate(1.15);border:1px solid rgba(255,255,255,.55);box-shadow:0 8px 28px rgba(30,61,43,.12);border-radius:16px;padding:16px 18px}
.nb-alert{display:flex;align-items:center;gap:8px;color:#C0392B;font-weight:800;font-size:14.5px;margin-bottom:12px}
.nb-alert .ic{flex:0 0 auto;font-size:16px;line-height:1}
/* barra de estoque acabando — estática */
.nb-stock{height:5px;border-radius:999px;background:rgba(30,61,43,.14);overflow:hidden;margin:-4px 0 14px}
.nb-stock-fill{display:block;height:100%;width:24%;background:#E02B20;border-radius:999px}
.nb-head{display:flex;align-items:center;gap:12px;flex-wrap:wrap;font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:17px;color:var(--navy);letter-spacing:.5px;text-transform:uppercase}
.nb-pill{background:var(--hl);color:var(--navy);font-weight:800;font-size:12.5px;letter-spacing:1px;padding:4px 12px;border-radius:6px}
.nb-list{list-style:none;margin:12px 0 16px}
.nb-list li{display:flex;gap:9px;align-items:flex-start;padding:4px 0;font-size:15.5px;font-weight:600;color:var(--ink)}
.nb-list .d{color:var(--navy);flex:0 0 auto;font-weight:900}
.nb-rows{display:grid;gap:8px}
.nb-row{display:flex;justify-content:space-between;align-items:center;gap:10px;border-radius:999px;padding:10px 18px;font-weight:800;font-size:12.5px;letter-spacing:1.2px;text-transform:uppercase}
.nb-row.past{background:rgba(240,240,234,.55);color:#7d7d73}
.nb-row.cur{background:#D3EF5F;color:var(--navy)}
.nb-row.up{background:rgba(255,255,255,.6);border:1px solid rgba(255,255,255,.7);color:var(--navy-2)}
@media(max-width:640px){
  .heroext{margin-top:18px}
  .nextbatch{padding:15px 14px}
  .nb-head{font-size:15px}
  .nb-list li{font-size:14px}
  .nb-row{padding:9px 14px;font-size:11px;letter-spacing:.8px}
  .herotesti{grid-template-columns:64px minmax(0,1fr);padding:12px}
  .ht-ph{width:64px;height:70px}
}

/* ===== desktop: cards compactos em 2 colunas dentro do hero (precisa vir DEPOIS das regras base) ===== */
@media(min-width:861px){
  .heroext{grid-template-columns:1.05fr 1fr;gap:12px;max-width:66%;margin-top:18px;align-items:stretch}
  .hx-left{gap:8px}
  .statsbar{padding:12px 4px}
  .stat{padding:2px 8px;gap:4px}
  .stat .v{font-size:16px}
  .stat .l{font-size:9px;letter-spacing:.5px;line-height:1.4;max-width:104px}
  .herotesti{padding:8px 10px;grid-template-columns:50px minmax(0,1fr);gap:9px}
  .ht-ph{width:50px;height:54px}
  .ht-stars{font-size:9.5px;letter-spacing:1px}
  .ht-ver{font-size:8.5px;letter-spacing:1px}
  .ht-q{font-size:12.5px;margin:2px 0 2px;line-height:1.3}
  .ht-n{font-size:10.5px}
  .nextbatch{padding:10px 13px;border-radius:14px}
  .nb-alert{font-size:10.5px;margin-bottom:6px}
  .nb-alert .ic{font-size:12px}
  .nb-stock{height:4px;margin:-2px 0 9px}
  .nb-head{font-size:12px}
  .nb-pill{font-size:9.5px;padding:2px 8px}
  .nb-list{margin:6px 0 8px}
  .nb-list li{font-size:11px;padding:1px 0}
  .nb-rows{gap:4px}
  .nb-row{padding:5px 11px;font-size:9px;letter-spacing:.7px}
}
</style>
</head>
<body>
<!-- ============================================================
     V3 — LISTICLE. Diagramação copiada dos prints do modelo:
     - Reason = 2 colunas, texto/imagem ALTERNANDO de lado
     - fundo ALTERNA branco / verde escuro (1 branco, 2 escuro, 3 branco...)
     - "Reason N" em serifa itálica com marca-texto lima atrás
     - grid de ícones em 3 colunas
     - após o Reason 5: divisor tracejado + "The Bottom Line:"
     - prova social: fundo lima claro, 3 cards lado a lado
     - números: verde escuro, texto à esquerda (2x2) + imagem à direita
     - FAQ: fundo lima claro, 2 colunas de cards com botão "+"
     - footer: 3 colunas com divisórias, avisos, moeda e copyright centrados
     FOTOS = placeholders. Copy nova = Lorem ipsum (class="lorem").
     ============================================================ -->
<style>
/* ---------- nav: barra verde escura, logo + botão lima ---------- */
.lnav{background:var(--navy);padding:13px 0}
.lnav-in{max-width:1180px;margin:0 auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.lnav-logo{height:42px;width:auto;max-width:none;display:block;filter:brightness(0) invert(1)}
.lnav-cta{background:#C8F58A;color:var(--navy);text-decoration:none;font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:14.5px;line-height:1;padding:12px 20px;border-radius:6px;white-space:nowrap}
.lnav-cta:hover{filter:brightness(1.06)}

/* ---------- hero: fundo verde, texto esquerda + produto direita ---------- */
/* overflow:hidden é o que corta o produto na base do hero — no modelo os frascos
   vazam para baixo e são cortados pela faixa corrida.
   A cor de fundo fica embaixo da foto: se a imagem não carregar, o hero não perde o verde. */
.lhero{background:#2C6B4F none center/cover no-repeat;overflow:hidden}
/* coluna única: a metade direita fica livre de propósito, é onde os frascos do
   fundo aparecem. O max-width do texto é o que impede a sobreposição. */
.lhero-in{max-width:1320px;margin:0 auto;padding:0 24px;display:flex;align-items:center;min-height:390px}
.lhero-txt{padding:44px 0;max-width:540px}
.lhero-h1{font-family:'DM Serif Display',Georgia,serif;font-weight:400;font-size:clamp(27px,3.5vw,43px);line-height:1.17;color:#fff;margin:0 0 14px}
.lhero-h1 em{font-style:italic;color:#C8F58A}
.lhero-p{font-size:15px;line-height:1.55;color:rgba(255,255,255,.92);margin:0;max-width:520px}
/* .lhero-med foi removido: o produto agora vem dentro da própria foto de fundo */

/* ---------- marquee de benefícios (corre na horizontal) ---------- */
.mq{background:#EFF9DE;border-top:1px solid #e0eecb;border-bottom:1px solid #e0eecb;overflow:hidden;padding:11px 0}
.mq-track{display:flex;width:max-content;animation:mqScroll 38s linear infinite;will-change:transform}
.mq:hover .mq-track{animation-play-state:paused}
.mq-set{display:flex;align-items:center;flex:0 0 auto}
.mq-i{display:inline-flex;align-items:center;font-weight:700;font-size:15px;color:var(--navy);white-space:nowrap;padding-left:26px}
.mq-i:after{content:"•";color:#8CC63F;margin-left:26px;font-size:17px;line-height:1}
@keyframes mqScroll{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}
@media(prefers-reduced-motion:reduce){.mq-track{animation:none}}

/* ---------- linha de fontes ---------- */

/* ---------- REASON: 2 colunas alternando ---------- */
.rsn{padding:56px 0;background:var(--cream-2)}
/* seções verdes: foto de fundo sobre a cor sólida (a cor segura a leitura se a foto falhar) */
.rsn.dark{background:var(--navy) none center/cover no-repeat}
/* stretch, não center: a foto acompanha a altura do texto da linha.
   Com align-items:center e proporção fixa sobrava um vazio enorme ao lado dos
   Reasons longos (394px no 1) e, quando a foto era maior que o texto, ela é que
   passava a mandar na altura da linha (+216px no Reason 2). */
.rsn-in{max-width:1320px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:44px;align-items:stretch}
/* a foto é absoluta para NÃO entrar no cálculo da altura da linha: quem manda é o
   texto. Sem isso a foto do Reason 2 (retrato 0,80) esticava a linha em 217px
   sozinha, mesmo com o texto ocupando bem menos. */
.rsn-med{position:relative;min-height:520px}
.rsn.rev .rsn-med{order:-1}
.rsn-med .ph{min-height:420px;border-radius:14px}
.rsn.dark .rsn-med .ph{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.32);color:rgba(255,255,255,.72)}
/* aspect-ratio + cover normaliza fotos de proporções bem diferentes (têm de 3:4 a 3:1) */
/* A foto preenche a coluna inteira; quem define a altura da linha é o texto.
   object-fit:cover normaliza as proporções de origem, que variam muito
   (1 e 3 = 0,75 · 2 = 0,80 · 4 = 1,50 · 5 = 2,22) — as duas paisagens perdem
   laterais, conferir ao trocar a arte. min-height segura os Reasons curtos. */
.rsn-med img,.st4-med img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;display:block;border-radius:14px}
/* "Reason N" com marca-texto lima */
.rsn-num{display:inline-block;font-family:'DM Serif Display',Georgia,serif;font-style:italic;font-size:clamp(20px,2.2vw,26px);line-height:1;color:var(--navy);background:linear-gradient(180deg,transparent 52%,#C8F58A 52%,#C8F58A 92%,transparent 92%);padding:0 6px 3px;margin:0 0 16px}
/* no fundo escuro o rótulo INVERTE: texto lima sobre faixa verde escura.
   Estava como no fundo claro (texto navy sobre lima) e ficava ilegível. */
.rsn.dark .rsn-num{color:#C8F58A;background:linear-gradient(180deg,transparent 52%,rgba(0,0,0,.30) 52%,rgba(0,0,0,.30) 92%,transparent 92%)}
.rsn-h{font-family:'DM Serif Display',Georgia,serif;font-weight:400;font-size:clamp(22px,2.5vw,30px);line-height:1.22;color:var(--navy);margin:0 0 16px}
/* títulos das seções escuras (Reason 2 e 4) em lima claro, a pedido */
.rsn.dark .rsn-h{color:#D8F7A8}
.rsn-txt p{font-size:15.5px;line-height:1.62;color:#41564a;margin:0 0 15px}
.rsn.dark .rsn-txt p{color:rgba(255,255,255,.86)}
.rsn-txt p b{color:var(--navy)}
.rsn.dark .rsn-txt p b{color:#fff}
/* lista de benefícios (Reason 1 e 5): check verde + título + descrição.
   Substituiu o grid de ícones do modelo — a copy do doc traz par título+explicação,
   que não cabe no rótulo de uma linha do .icg. */
.rsnb{list-style:none;margin:0 0 18px;padding:0;display:grid;gap:14px}
.rsnb li{display:grid;grid-template-columns:20px minmax(0,1fr);gap:11px;align-items:start}
.rsnb-ck{width:20px;height:20px;margin-top:2px;border-radius:50%;background:#12A84A;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto}
.rsnb-ck svg{width:11px;height:11px;fill:none;stroke:#fff;stroke-width:3.6;stroke-linecap:round;stroke-linejoin:round}
/* ⚠️ Escopar em `div`: o check também é um <span>, e um `.rsnb span` solto (0,1,1)
   vencia o `.rsnb-ck` (0,1,0) por especificidade, trocando o inline-flex por block.
   O círculo continuava verde, mas o ✓ ia parar no canto em vez de centralizado. */
.rsnb div b{display:block;font-size:15.5px;line-height:1.4;color:var(--navy);margin-bottom:2px}
.rsnb div span{display:block;font-size:14.5px;line-height:1.55;color:#41564a}
.rsnb.tight{gap:11px}
.rsn.dark .rsnb div b{color:#fff}
.rsn.dark .rsnb div span{color:rgba(255,255,255,.86)}
/* linha de virada do Reason 1 — destaque sem virar citação */
.rsn-pull{font-weight:700;color:var(--navy) !important;border-left:3px solid #87E64B;padding-left:14px;margin:0 0 20px !important}
.rsn.dark .rsn-pull{color:#fff !important}
/* grid de ícones — 3 colunas */
.icg{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px 16px;margin:20px 0 20px}
.icg-i{min-width:0}
.icg-ic{width:34px;height:34px;display:block;margin:0 0 10px}
.icg-ic img{width:100%;height:100%;max-width:none;object-fit:contain;display:block}
.rsn.dark .icg-ic img{filter:brightness(0) invert(1)}
.icg-t{display:block;font-size:14px;line-height:1.35;color:#41564a}
.rsn.dark .icg-t{color:rgba(255,255,255,.9)}
/* variante em caixas (Reason 4 do modelo) */
.icg.boxed{grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
/* ícone e texto centralizados na caixa. O flex-column centraliza também na vertical,
   que importa porque os três textos têm alturas diferentes e o grid iguala as caixas. */
.icg.boxed .icg-i{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.2);border-radius:12px;padding:18px 14px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.icg.boxed .icg-ic{width:30px;height:30px;margin:0 0 10px}
/* CTA único em toda a página: pílula lima com texto escuro e seta.
   Mesma família do .btn-orange da LP — não varia entre fundo claro e escuro. */
.btn-r{display:inline-flex;align-items:center;gap:.75em;text-decoration:none;font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:clamp(15px,1.4vw,19px);letter-spacing:.2px;line-height:1.15;padding:17px 34px;border-radius:10px;background:linear-gradient(180deg,#9BF25C 0%,#63D62F 100%);color:var(--navy);box-shadow:0 8px 22px rgba(135,230,75,.42);transition:transform .12s ease,filter .2s}
.btn-r em{font-style:normal}
.btn-r .arr{display:inline-block;transition:transform .15s}
.btn-r:hover{transform:translateY(-2px);filter:brightness(1.06)}
.btn-r:hover .arr{transform:translateX(4px)}
.rsn-sup{display:flex;align-items:center;gap:9px;margin:14px 0 0;font-size:14.5px;color:#41564a}
.rsn.dark .rsn-sup{color:rgba(255,255,255,.9)}
.rsn-sup .ck{width:18px;height:18px;border-radius:50%;background:#12A84A;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto}
.rsn-sup .ck svg{width:10px;height:10px;fill:none;stroke:#fff;stroke-width:3.6;stroke-linecap:round;stroke-linejoin:round}

/* ---------- bottom line ---------- */
.btl{background:var(--cream-2);padding:0 0 56px}
.btl-in{max-width:1320px;margin:0 auto;padding:0 24px}
.btl-hr{border:none;border-top:2px dashed #9db3a5;margin:0 0 34px}
.btl h3{font-family:'DM Serif Display',Georgia,serif;font-weight:400;font-size:clamp(21px,2.3vw,27px);color:var(--navy);margin:0 0 14px}
.btl p{font-size:15.5px;line-height:1.62;color:#41564a;margin:0;max-width:900px}

/* ---------- prova social ---------- */
.sp2{background:#EFF9DE;padding:48px 0}
.sp2-in{max-width:1180px;margin:0 auto;padding:0 24px}
.sp2-rate{display:flex;align-items:center;gap:8px;font-size:14.5px;color:var(--navy);margin-bottom:10px}
.sp2-rate .stars{color:#12A84A;letter-spacing:2px;font-size:15px}
.sp2-rate u{text-underline-offset:2px}
.sp2-h{font-family:'DM Serif Display',Georgia,serif;font-weight:400;font-size:clamp(25px,3.3vw,38px);line-height:1.16;color:var(--navy);margin:0 0 26px}
.sp2-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.sp2-card{background:#fff;border-radius:12px;padding:20px 20px 18px;box-shadow:0 2px 10px rgba(18,60,42,.06)}
.sp2-top{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.sp2-nnum{font-weight:800;font-size:14px;color:var(--navy)}
.sp2-sq{display:inline-flex;gap:2px}
.sp2-sq i{width:15px;height:15px;background:#12A84A;border-radius:2px;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:9px;font-style:normal;line-height:1}
.sp2-t{font-weight:800;font-size:16px;line-height:1.35;color:var(--navy);margin:0 0 10px}
.sp2-q{font-size:14.5px;line-height:1.55;color:#41564a;margin:0 0 16px}
.sp2-who{display:flex;align-items:center;gap:10px}
.sp2-av{width:34px;height:34px;border-radius:50%;flex:0 0 auto;min-height:0;font-size:7px;padding:2px}
.sp2-nm{display:block;font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:12.5px;letter-spacing:.5px;text-transform:uppercase;color:var(--navy);line-height:1.3}
.sp2-vb{display:flex;align-items:center;gap:5px;font-size:11.5px;letter-spacing:.4px;text-transform:uppercase;color:#12A84A;font-weight:700}
.sp2-vb svg{width:11px;height:11px;fill:none;stroke:#12A84A;stroke-width:2.4}
.sp2-cta{text-align:center;margin-top:30px}
.sp2-cta .rsn-sup{justify-content:center;margin-top:14px}

/* ---------- números (fundo escuro, 2 colunas) ---------- */
.st4{background:var(--navy) none center/cover no-repeat;padding:52px 0}
.st4-in{max-width:1180px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:44px;align-items:center}
.st4-h{font-family:'DM Serif Display',Georgia,serif;font-weight:400;font-size:clamp(23px,2.7vw,33px);line-height:1.18;color:#fff;margin:0 0 12px}
.st4-lead{font-size:15px;line-height:1.6;color:rgba(255,255,255,.85);margin:0 0 26px}
.st4-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 22px;margin-bottom:28px}
.st4-n{display:block;font-family:'DM Serif Display',Georgia,serif;font-style:italic;font-size:clamp(24px,2.6vw,32px);line-height:1.1;color:#C8F58A}
.st4-l{display:block;font-family:'DM Serif Display',Georgia,serif;font-size:clamp(19px,2.1vw,26px);line-height:1.15;color:#C8F58A;margin-bottom:9px}
.st4-d{font-size:14px;line-height:1.5;color:rgba(255,255,255,.85);margin:0}
.st4 .rsn-sup{color:rgba(255,255,255,.9)}
.st4-med .ph{min-height:420px;border-radius:14px;background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.32);color:rgba(255,255,255,.72)}

/* ---------- FAQ ---------- */
.faq2{background:linear-gradient(180deg,#EFF9DE,#DFF0C9);padding:48px 0}
.faq2-in{max-width:1180px;margin:0 auto;padding:0 24px}
.faq2-k{font-size:14px;color:#4a6b3f;margin:0 0 6px}
.faq2-h{font-family:'DM Serif Display',Georgia,serif;font-weight:400;font-size:clamp(25px,3.3vw,38px);color:var(--navy);margin:0 0 26px}
.faq2-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 22px}
.faq2 details{background:#fff;border-radius:10px;box-shadow:0 1px 5px rgba(18,60,42,.06);overflow:hidden}
.faq2 summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:17px 18px;font-size:15px;color:var(--navy)}
.faq2 summary::-webkit-details-marker{display:none}
.faq2 summary:after{content:"+";flex:0 0 auto;width:28px;height:28px;border-radius:6px;background:var(--navy);color:#fff;font-weight:700;font-size:17px;display:flex;align-items:center;justify-content:center;line-height:1}
.faq2 details[open] summary:after{content:"–"}
.faq2 .a{padding:0 18px 17px;font-size:14.5px;line-height:1.6;color:#41564a}
.faq2-cta{text-align:center;margin-top:30px}
.faq2-cta .rsn-sup{justify-content:center;margin-top:14px}

/* ---------- footer ---------- */
.ft2{background:var(--navy);color:#cfe3d6;padding:44px 0 26px}
.ft2-wrap{max-width:1180px;margin:0 auto;padding:0 24px}
.ft2-top{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr) minmax(0,1fr);gap:0}
.ft2-c{padding:0 30px}
.ft2-c+.ft2-c{border-left:1px solid rgba(255,255,255,.18)}
.ft2-logo{width:150px;height:auto;display:block;filter:brightness(0) invert(1)}
.ft2-h{font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:16px;color:#fff;margin:0 0 8px}
.ft2-s{font-size:14px;color:rgba(207,227,214,.9);margin:0 0 16px}
.ft2-form{display:flex;background:#fff;border-radius:4px;overflow:hidden;max-width:330px}
.ft2-form input{flex:1 1 auto;min-width:0;border:none;padding:12px 14px;font-family:inherit;font-size:14px;color:#123C2A}
.ft2-form input:focus{outline:2px solid #A7E85F;outline-offset:-2px}
.ft2-form button{border:none;cursor:pointer;background:#fff;border-left:1px solid #dfeae0;color:#123C2A;font-family:inherit;font-weight:700;font-size:14px;padding:12px 20px}
.ft2-links{list-style:none;margin:0;padding:0}
.ft2-links li{margin:0 0 11px}
.ft2-links a{color:#cfe3d6;text-decoration:none;font-size:14.5px}
.ft2-links a:hover{color:#fff;text-decoration:underline}
.ft2-dis{margin:30px 0 0;font-size:11.5px;line-height:1.7;color:rgba(207,227,214,.72)}
.ft2-dis p{margin:0}
.ft2-cur{text-align:center;margin:22px 0 0}
.ft2-cur select{background:transparent;color:#cfe3d6;border:none;font-family:inherit;font-size:14px;cursor:pointer}
.ft2-cur select option{color:#123C2A}
.ft2-cp{text-align:center;margin:16px 0 0;font-size:13px;color:rgba(207,227,214,.85)}

@media(max-width:900px){
  /* mobile: fundo retrato com os frascos embaixo — ancorar no rodapé e dar altura
     suficiente para o texto ficar em cima e os frascos aparecerem inteiros */
  .lhero{background-image:none;background-position:center bottom}
  /* Os frascos começam a 53,4% da altura da arte (medido em 03-hero-bg-mobile.png,
     439×554). Com o hero em 560px eles batiam em 299px e o parágrafo terminava em
     308px — 9px de sobreposição. Subir o texto e alongar o hero empurra os frascos
     para 331px e abre ~40px de respiro.
     O hero mais alto corta mais as laterais (cover), mas cabe: os frascos vivem
     entre 30,1% e 71,1% da largura, ou seja, ~29% de folga de cada lado. */
  .lhero-in{min-height:560px;align-items:flex-start}
  .lhero-txt{padding:14px 0 0;max-width:none}
  .rsn-in,.st4-in{grid-template-columns:1fr;gap:26px}
  .rsn.rev .rsn-med{order:0}
  .rsn-med .ph,.st4-med .ph{min-height:280px}
  /* em coluna única não há altura de linha para acompanhar: a foto volta ao fluxo
     com proporção fixa, senão o min-height de 520px daria uma foto altíssima em 390px */
  .rsn-med{min-height:0}
  .rsn-med img,.st4-med img{position:static;height:auto;aspect-ratio:4/5}
  .sp2-cards{grid-template-columns:1fr;max-width:520px}
  .faq2-grid{grid-template-columns:1fr}
  .ft2-top{grid-template-columns:1fr;gap:26px}
  .ft2-c{padding:0}
  .ft2-c+.ft2-c{border-left:none;border-top:1px solid rgba(255,255,255,.18);padding-top:22px}
}
@media(max-width:640px){
  .rsn{padding:36px 0}
  .rsn-in,.st4-in,.btl-in,.sp2-in,.faq2-in,.ft2-wrap{padding-left:18px;padding-right:18px}
  .icg{gap:16px 12px}
  .icg.boxed{grid-template-columns:1fr}
  .btn-r{display:block;text-align:center;padding:16px 18px}
  .blt-row{gap:8px 16px;padding:8px 14px}
  .blt-i{font-size:12.5px;gap:7px}
  .blt-i .dot{width:18px;height:18px}
  .st4-grid{grid-template-columns:1fr;gap:22px}
}
/* .lorem é só MARCADOR de copy provisória — não pode declarar cor.
   Com `color:inherit` ela vinha depois no CSS e apagava o branco das seções escuras
   (st4-h, st4-lead e st4-l ficavam em cor de texto escura sobre fundo verde). */
.lorem{opacity:.95}
</style>

