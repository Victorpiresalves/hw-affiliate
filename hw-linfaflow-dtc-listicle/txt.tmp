<!-- ============ PROVEN BENEFITS + WHEN FLOW BACKS UP ============ -->
<style>
.pben{background:#EDFBF3;border-top:1px solid #d9e4d8}
.pb-wrap{max-width:1180px;margin:0 auto;padding:0 20px}
.pb-title{font-family:'DM Serif Display',Georgia,serif;font-weight:400;font-size:clamp(25px,2.7vw,34px);color:var(--navy);margin:0 0 20px;letter-spacing:0}
.pb-top{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,330px);gap:26px;align-items:start}
.pb-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.pb-stat{background:#fff;border:1px solid #d6ece0;border-radius:12px;padding:16px 16px 18px;min-width:0}
.pb-stat .pv{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px}
.pb-stat .num{font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:clamp(26px,2.6vw,32px);color:#2FA968;line-height:1}
.pb-stat .up{width:30px;height:30px;border-radius:50%;background:#E4F7EC;color:#2FA968;display:inline-flex;align-items:center;justify-content:center;font-size:15px;font-weight:900;flex:0 0 auto}
.pb-stat p{margin:0;font-size:14.5px;line-height:1.45;color:#41564a}
.pb-quote{display:flex;gap:14px;align-items:flex-start;background:transparent}
.pb-quote img{width:104px;height:118px;object-fit:cover;border-radius:10px;flex:0 0 auto;display:block}
.pb-quote .q{font-style:italic;font-size:14.5px;line-height:1.5;color:#41564a;margin:0 0 10px}
.pb-quote .who{display:flex;align-items:center;gap:7px;font-weight:700;font-size:14px;color:var(--ink)}
.pb-quote .dot{width:15px;height:15px;border-radius:50%;background:#2FA968;color:#fff;font-size:9px;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto}
.pb-flow{border-top:1px solid #d6ece0;margin-top:30px;padding-top:30px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:34px;align-items:center}
.pb-flow .lead{font-size:15.5px;line-height:1.55;color:#41564a;margin:0 0 20px;max-width:460px}
.pb-rows{display:grid;gap:12px}
.pb-row{display:grid;grid-template-columns:minmax(0,150px) 34px minmax(0,150px);align-items:center;gap:10px}
.pill{display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:8px 14px;font-weight:700;font-size:14px;white-space:nowrap;min-width:0}
.pill.bad{background:#FDECEC;color:#C0392B;border:1px solid #F5C9C4}
.pill.good{background:#E4F7EC;color:#1E7A4C;border:1px solid #B9E6CD}
.pill .ic{width:16px;height:16px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:900;color:#fff;flex:0 0 auto}
.pill.bad .ic{background:#C0392B}
.pill.good .ic{background:#2FA968}
.pb-arrow{color:#9bbfa9;text-align:center;font-size:18px;line-height:1}
.pb-flow img.fig{width:100%;height:auto;display:block;border-radius:14px}
@media(max-width:900px){
  .pb-top{grid-template-columns:1fr;gap:20px}
  .pb-flow{grid-template-columns:1fr;gap:22px}
  .pb-quote{max-width:520px}
}
@media(max-width:620px){
  .pb-stats{grid-template-columns:1fr}
  .pb-row{grid-template-columns:minmax(0,1fr) 28px minmax(0,1fr)}
  .pill{font-size:13px;padding:7px 11px}
}
</style>
